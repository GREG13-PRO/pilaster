<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pilaster.Core</RootNamespace>
    <AssemblyName>Pilaster.Core</AssemblyName>

    <!--
      A [LibraryImport] forrásgenerátor unsafe kódot állít elő (a natív
      rendezéshez használt StrCmpLogicalW miatt kell). Ez a generált kódra
      vonatkozik, saját unsafe blokkot nem írunk.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(ExtensionsVersion)" />
  </ItemGroup>

</Project>
