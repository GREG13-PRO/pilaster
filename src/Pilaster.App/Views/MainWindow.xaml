<ui:FluentWindow
    x:Class="Pilaster.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:fs="clr-namespace:Pilaster.Core.FileSystem;assembly=Pilaster.Core"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:metadata="clr-namespace:Pilaster.Core.Metadata;assembly=Pilaster.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="Pilaster"
    Width="1280"
    Height="820"
    MinWidth="720"
    MinHeight="480"
    d1p1:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>

        <!--
            Animációs időzítések. A belépés gyorsabb, mint a kilépés: a
            rámutatásra azonnali választ várunk, az elhagyás viszont lágyabban
            olvad ki, különben a lista villogónak hat gyors egérmozgásnál.
        -->
        <Duration x:Key="HoverInDuration">0:0:0.10</Duration>
        <Duration x:Key="HoverOutDuration">0:0:0.18</Duration>

        <!--  Kiemelés átúsztatással — a sorok, csempék és oldalsáv-elemek közös mintája  -->
        <Storyboard x:Key="FadeInHighlight">
            <DoubleAnimation
                Storyboard.TargetName="Hover"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="{StaticResource HoverInDuration}" />
        </Storyboard>
        <Storyboard x:Key="FadeOutHighlight">
            <DoubleAnimation
                Storyboard.TargetName="Hover"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="{StaticResource HoverOutDuration}" />
        </Storyboard>

        <!--
            Csúszó átmenet a fájlterületen, valahányszor a megnyitott mappa
            változik (gyorselérésre kattintás, breadcrumb, vissza/előre,
            dupla kattintás egy mappára). A CubicEase.EaseOut adja a
            "lelassuló becsapódás" érzetet, ami premium hatást kelt anélkül,
            hogy szaggatottnak hatna — lásd MainWindow.xaml.cs PlayContentTransition.
        -->
        <Duration x:Key="ContentSlideDuration">0:0:0.22</Duration>
        <Storyboard x:Key="SlideInFileArea">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="14"
                To="0"
                Duration="{StaticResource ContentSlideDuration}">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0.4"
                To="1"
                Duration="{StaticResource ContentSlideDuration}" />
        </Storyboard>

        <!--
            Egységes eszköztár-gomb: minden ikon-gomb (navigáció, létrehozás,
            overflow, téma, beállítások) azonos méretű, azonos lekerekítésű és
            azonos térközű — korábban minden gomb a WPF-UI alapértelmezett
            méretét kapta, ami finoman eltérő volt gombtípusonként.

            FONTOS: az ikont MINDIG a gomb közvetlen tartalmaként add meg
            (<ui:Button><ui:SymbolIcon .../></ui:Button>), NE a
            <ui:Button.Icon> tulajdonságon keresztül. Ez utóbbi ezen a
            WPF-UI verzión (4.3.0) néha teljesen üresen marad — sem
            képernyőn, sem RenderTargetBitmap-es önrenderelésnél nem jelenik
            meg semmi, miközben az önálló SymbolIcon megbízhatóan működik.
            Több elszigetelt próbaalkalmazással megerősítve.

            A háttér SAJÁT ControlTemplate-tel van kikényszerítve, nem a
            beépített Appearance="Transparent" tulajdonsággal: az utóbbi ezen
            a WPF-UI verzión alapállapotban is egy világos/szürke dobozt
            hagyott a gomb mögött (különösen feltűnő sötét témában), holott
            névleg átlátszót kellene adnia — feltehetően ugyanaz a fajta
            sablon-feloldási megbízhatatlanság, ami a Button.Icon hibáját is
            okozta. A saját sablon teljes kontrollt ad: nyugalmi állapotban
            garantáltan nincs háttér, az ikon a téma szövegszínét követi
            (nem hardcode-olt fehér), és csak rámutatáskor/lenyomáskor jelenik
            meg egy finom kiemelés.
        -->
        <Style x:Key="ToolbarButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="Pressed"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Fájlelemek helyi menüje. Egyetlen megosztott példány — mivel
            egyszerre csak egy nyílhat meg, ez biztonságosan újrahasználható a
            részletes és a rács nézet minden során/csempéjén. A DataContext
            explicit átirányítása kell, mert a ContextMenu popupként külön
            vizuális fában él, és nem örökli automatikusan a
            PlacementTarget adatkontextusát.
        -->
        <ContextMenu x:Key="FileItemContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnGlassContextMenuOpened">
            <MenuItem Click="OnOpenItemClick" Header="{loc:Loc Cmd_Open}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnCopyPathClick" Header="{loc:Loc Cmd_CopyPath}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnShowInExplorerClick" Header="{loc:Loc Cmd_ShowInExplorer}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnShowPropertiesClick" Header="{loc:Loc Cmd_Properties}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!--
            Az üres terület helyi menüje. Elsődlegesen a VALÓDI Windows
            háttér-menü jelenik meg (NativeContextMenuService.ShowBackgroundAsync,
            hívva az OnEmptyAreaPreviewRightButtonDown kódból) — ez csak akkor
            nyílik meg kézzel, ha a natív menü valamiért nem elérhető. Nincs
            Setter Property="ContextMenu" a DetailsView/GridViewList-en, hogy
            a WPF automatikus megnyitása ne ütközzön a kézi hívással.
        -->
        <ContextMenu x:Key="EmptyAreaContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnGlassContextMenuOpened">
            <MenuItem Command="{Binding CreateNewFolderCommand}" Header="{loc:Loc Cmd_NewFolder}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CreateNewFileCommand}" Header="{loc:Loc Cmd_NewFile}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DocumentAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding PasteCommand}" Header="{loc:Loc Cmd_Paste}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ClipboardPaste24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding SelectedTab.RefreshCommand}" Header="{loc:Loc Cmd_Refresh}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Loc Cmd_SortBy}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowSort24" />
                </MenuItem.Icon>
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Name}" Tag="{x:Static fs:SortKey.Name}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Size}" Tag="{x:Static fs:SortKey.Size}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Type}" Tag="{x:Static fs:SortKey.Type}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Modified}" Tag="{x:Static fs:SortKey.Modified}" />
            </MenuItem>
        </ContextMenu>

        <!--  Oldalsáv sor  -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!--
                            Background="Transparent" a gyökér Griden: null hátér
                            mellett a WPF csak a gyerekelemek konkrét
                            tartalmán (szöveg glyph-jei, kitöltött ikon-terület)
                            hit-testel, a köztük lévő "üres" résekben a
                            kattintás átesne a sorra. Transparent ecsettel az
                            EGÉSZ sor területe kattinthatóvá válik.
                        -->
                        <Grid Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="7"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="7"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>

                            <!--
                                Az aktuálisan megnyitott mappa ÉS annak minden őse
                                kiemelve (pl. "Dokumentumok" akkor is aktív, ha épp
                                egy almappájában vagyunk) — útvonal alapján, nem a
                                ListBox kijelölés-állapotán keresztül. Lásd
                                MainWindowViewModel.IsPathOrAncestor. (A fülsáv is
                                ezt a stílust használja, de a TabViewModelnek nincs
                                IsActive tulajdonsága, ezért ott a trigger
                                ártalmatlanul soha nem talál kötést.)
                            -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Oszlopfejléc. A beépített GridView a klasszikus WPF-témát hozza
            magával (világos háttér, sötét szöveg), ami sötét módban idegen
            testként ülne a felületen — ezért saját sablont kap.
        -->
        <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0">
                            <StackPanel
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="Arrow"
                                    Margin="6,1,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>

                            <!--  A rendezés iránya nyíllal, ahogy az Explorerben  -->
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Ascending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25B2;" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Descending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Címke-pöttyök + kedvenc szív + címke-választó ikon egy fájlsoron —
            közös sablon a Részletes és a Rácsnézet között (lásd
            OnTagPickerClick / SelectedTab.ToggleFavoriteCommand). A
            RelativeSource AncestorType=Control a legközelebbi Control ősre
            (ListViewItem VAGY ListBoxItem, nézettől függően) hivatkozik —
            ez teszi lehetővé, hogy ugyanaz a sablon mindkét nézetben
            hoverre jelenítse meg a gombokat.
        -->
        <DataTemplate x:Key="FileBadgesTemplate" DataType="{x:Type fs:FileSystemItem}">
            <StackPanel Orientation="Horizontal">
                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type metadata:TagDefinition}">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="2,0"
                                Fill="{Binding Color, Converter={StaticResource TagColorBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button
                    Margin="4,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="OnTagPickerClick"
                    ToolTip="{loc:Loc Cmd_Tags}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="12" Symbol="Tag24" />
                </ui:Button>

                <ui:Button
                    Margin="2,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Command="{Binding DataContext.SelectedTab.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    CommandParameter="{Binding}"
                    ToolTip="{loc:Loc Cmd_AddFavorite}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="13" Filled="{Binding IsFavorite}" Symbol="Heart24">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="#E81123" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </StackPanel>
        </DataTemplate>

        <!--  Fájllista sor a részletes nézetben  -->
        <Style x:Key="FileRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <!--
                Nincs Setter Property="ContextMenu" itt: a jobbklikket
                OnItemPreviewRightButtonDown kezeli, ami a VALÓDI Windows
                shell menüt hívja meg (NativeContextMenuService) — a
                FileItemContextMenu csak akkor nyílik meg kézzel, ha a
                natív menü valamiért nem elérhető.
            -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!--  Background="Transparent": lásd a SidebarItemStyle megjegyzését.  -->
                        <Grid Margin="4,1" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Csempe a rácsnézetben  -->
        <Style x:Key="FileTileStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <!--
                Nincs Setter Property="ContextMenu" itt: a jobbklikket
                OnItemPreviewRightButtonDown kezeli, ami a VALÓDI Windows
                shell menüt hívja meg (NativeContextMenuService) — a
                FileItemContextMenu csak akkor nyílik meg kézzel, ha a
                natív menü valamiért nem elérhető.
            -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!--  Background="Transparent": lásd a SidebarItemStyle megjegyzését.  -->
                        <Grid Margin="4" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border Padding="6,10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sor egy oszlopos nézet oszlopában — a FileTileStyle könnyített, keret nélküli változata  -->
        <Style x:Key="ColumnItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="4,1" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Címsor  -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Pilaster"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Pilaster;component/Assets/app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--
            Felső sáv — „liquid glass" háttér a fülsor ÉS az eszköztár mögött.
            A fülsáv/eszköztár saját tartalma változatlan; ez a Border csak a
            hátterüket adja, ezért kerül eléjük a Grid gyermeksorrendjében.
        -->
        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="6,2,6,2"
            Background="{DynamicResource GlassPanelBrush}"
            CornerRadius="9" />

        <!--  Fülsáv  -->
        <Border
            Grid.Row="1"
            Padding="10,0,10,4">
            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Padding" Value="12,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="15"
                                Symbol="Folder24" />
                            <TextBlock
                                MaxWidth="180"
                                VerticalAlignment="Center"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--  Eszköztár: navigáció, útvonalsáv, keresés, nézetváltó  -->
        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="0,0,8,0"
                Orientation="Horizontal">
                <ui:Button
                    Command="{Binding SelectedTab.GoBackCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoBack}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Back}">
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding SelectedTab.GoForwardCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoForward}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Forward}">
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding SelectedTab.GoUpCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoUp}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Up}">
                    <ui:SymbolIcon Symbol="ArrowUp24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding SelectedTab.RefreshCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Refresh}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button>

                <!--
                    Kiadás — csak akkor látszik, ha az aktív fül jelenlegi
                    mappája cserélhető vagy optikai meghajtón van. Lásd
                    MainWindowViewModel.CanEjectCurrentDrive és
                    Pilaster.Shell.Devices.RemovableDriveService.
                -->
                <ui:Button
                    Command="{Binding EjectCurrentDriveCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Eject}"
                    Visibility="{Binding CanEjectCurrentDrive, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ArrowEject20" />
                </ui:Button>

                <Rectangle
                    Width="1"
                    Margin="6,7"
                    Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!--  Két testreszabható gyorsgomb — a viselkedésük a Beállításokban állítható  -->
                <ui:Button
                    Command="{Binding RunQuickActionCommand}"
                    CommandParameter="1"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{Binding QuickAction1Label}">
                    <ui:SymbolIcon Symbol="{Binding QuickAction1Icon}" />
                </ui:Button>
                <ui:Button
                    Command="{Binding RunQuickActionCommand}"
                    CommandParameter="2"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{Binding QuickAction2Label}">
                    <ui:SymbolIcon Symbol="{Binding QuickAction2Icon}" />
                </ui:Button>
            </StackPanel>

            <!--
                Útvonalsáv. Kattintás az üres területére (nem egy szegmensre)
                szerkeszthető szövegmezőre vált — lásd
                OnBreadcrumbAreaPreviewLeftButtonDown — mint az Intézőben.
            -->
            <Border
                Grid.Column="1"
                Padding="6,3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                PreviewMouseLeftButtonDown="OnBreadcrumbAreaPreviewLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="{Binding SelectedTab.IsEditingPath, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{Binding SelectedTab.Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            Padding="7,3"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.OpenBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Label}" />
                                        <ui:SymbolIcon
                                            Margin="1,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Symbol="ChevronRight24" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ui:TextBox
                        x:Name="PathEditBox"
                        Grid.Column="0"
                        Padding="4,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        IsVisibleChanged="OnPathEditBoxIsVisibleChanged"
                        KeyDown="OnPathEditBoxKeyDown"
                        LostFocus="OnPathEditBoxLostFocus"
                        Text="{Binding SelectedTab.EditablePathText, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding SelectedTab.IsEditingPath, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Loc Path_Copied}"
                        Visibility="{Binding SelectedTab.PathCopied, Converter={StaticResource BoolToVisibility}}" />

                    <ui:Button
                        Grid.Column="2"
                        Padding="5"
                        Appearance="Transparent"
                        Command="{Binding SelectedTab.CopyPathCommand}"
                        ToolTip="{loc:Loc Cmd_CopyPath}">
                        <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                    </ui:Button>
                </Grid>
            </Border>

            <ui:TextBox
                Grid.Column="2"
                Width="240"
                Margin="8,0,8,0"
                PlaceholderText="{loc:Loc Search_Placeholder}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!--
                Kevésbé gyakran használt funkciók egy helyen. A nézetmód és a
                rejtett elemek kapcsolója korábban két külön, állandóan látható
                vezérlő volt (az utóbbi egy teljes szöveges felirattal) — ez
                zsúfolttá tette a sávot. Most egy tömör „több" gomb mögé
                kerültek, a gyakran használt navigáció/létrehozás/téma/
                beállítások gombok pedig változatlanul azonnal elérhetők.
            -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button
                    Click="OnOverflowMenuClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_More}">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    <ui:Button.ContextMenu>
                        <ContextMenu Opened="OnGlassContextMenuOpened">
                            <MenuItem Header="{loc:Loc View_Mode}">
                                <MenuItem Click="OnSetViewDetails" Header="{loc:Loc View_Details}" />
                                <MenuItem Click="OnSetViewGrid" Header="{loc:Loc View_Grid}" />
                                <MenuItem Click="OnSetViewColumns" Header="{loc:Loc View_Columns}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="{loc:Loc Cmd_ToggleHidden}"
                                IsCheckable="True"
                                IsChecked="{Binding SelectedTab.ShowHiddenItems, Mode=TwoWay}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>

                <!--  Téma-kapcsoló: az ikon azt mutatja, amire váltani fog  -->
                <ui:Button
                    Command="{Binding ToggleThemeCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_ToggleTheme}">
                    <ui:SymbolIcon Symbol="{Binding ThemeIcon}" />
                </ui:Button>

                <ui:Button
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Settings}">
                    <ui:SymbolIcon Symbol="Settings24" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <!--  Tartalom: frissítés-sáv + oldalsáv + fájllista  -->
        <Grid Grid.Row="3" Margin="10,0,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Frissítés-sáv. Nem tolakodó: csak akkor jelenik meg, ha van
                elérhető új verzió, és bármikor elvethető — lásd
                UpdateViewModel és Diagnostics/GitHubUpdateService.
            -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="14,9"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding Updates.IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Symbol="ArrowDownload24" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{Binding Updates.BannerText}" />

                    <ui:ProgressRing
                        Grid.Column="2"
                        Width="16"
                        Height="16"
                        Margin="0,0,10,0"
                        IsIndeterminate="True"
                        Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        Appearance="Primary"
                        Command="{Binding Updates.InstallUpdateCommand}"
                        Content="{loc:Loc Update_Action}"
                        Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <ui:Button
                        Grid.Column="3"
                        Command="{Binding Updates.DismissBannerCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{loc:Loc Cmd_Dismiss}">
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Oldalsáv — „liquid glass": GlassEffectService.ApplyInitial/SetEnabled kapcsolja GlassPanelBrush-t áttetsző/átlátszatlan között  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <ScrollViewer Padding="0,6" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SidebarSection}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock
                                        Margin="16,6,12,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Header}" />
                                    <ListBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                        ItemsSource="{Binding Items}"
                                        SelectionChanged="OnSidebarSelectionChanged"
                                        SelectionMode="Single">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                                                <StackPanel Opacity="{Binding IsMissing, Converter={StaticResource HiddenOpacity}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <!--
                                                                Behelyezett optikai lemeznél a saját
                                                                ikonja (autorun.inf/.ico) az általános
                                                                glyph helyett — lásd
                                                                SidebarItemViewModel.CustomIcon és
                                                                DiscIconResolver.
                                                            -->
                                                            <ui:SymbolIcon
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="16"
                                                                Symbol="{Binding Icon}"
                                                                Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                            <Image
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                Source="{Binding CustomIcon}"
                                                                Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Text="{Binding Label}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!--  Kedvenc eltávolítása — csak a Kedvencek szekció sorain (IsRemovable)  -->
                                                        <ui:Button
                                                            Grid.Column="1"
                                                            Padding="4"
                                                            VerticalAlignment="Center"
                                                            Appearance="Transparent"
                                                            Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{loc:Loc Cmd_RemoveFavorite}"
                                                            Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}">
                                                            <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                                                        </ui:Button>
                                                    </Grid>

                                                    <!--  Meghajtóknál kihasználtság-sáv  -->
                                                    <StackPanel
                                                        Margin="26,5,2,0"
                                                        Visibility="{Binding IsDrive, Converter={StaticResource BoolToVisibility}}">
                                                        <ProgressBar
                                                            Height="3"
                                                            Maximum="1"
                                                            Value="{Binding UsedFraction, Mode=OneWay}" />
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Címkék szekció — külön az ItemsControl-tól, mert nem
                        navigál, hanem az aktuális fül nézetét szűri (lásd
                        MainWindowViewModel.SelectTagFilterCommand /
                        TabViewModel.ActiveTagFilterId). Csak akkor jelenik
                        meg, ha van legalább egy létrehozott címke.
                    -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock
                            Margin="16,6,12,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{loc:Loc Nav_Tags}" />
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
                                    <ui:Button
                                        Padding="12,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.SelectTagFilterCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Appearance" Value="Secondary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="9"
                                                Height="9"
                                                Margin="0,0,10,0"
                                                Fill="{Binding Color, Converter={StaticResource TagColorBrush}}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                Background="Transparent" />

            <!--
                Fájlterület. A RenderTransform a SlideInFileArea storyboard
                célpontja — mappaváltáskor a MainWindow.xaml.cs
                PlayContentTransition indítja el, lásd a TrackTab-et.
            -->
            <Border
                x:Name="FileAreaBorder"
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="9"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="0" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FileListHost" Grid.Column="0">

                    <!--  Részletes nézet  -->
                    <ListView
                        x:Name="DetailsView"
                        Background="Transparent"
                        BorderThickness="0"
                        GridViewColumnHeader.Click="OnColumnHeaderClick"
                        ItemContainerStyle="{StaticResource FileRowStyle}"
                        ItemsSource="{Binding SelectedTab.Items}"
                        MouseDoubleClick="OnItemDoubleClick"
                        PreviewMouseRightButtonDown="OnEmptyAreaPreviewRightButtonDown"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Extended"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                                <GridViewColumn
                                    Width="380"
                                    controls:GridViewSort.SortKey="Name"
                                    Header="{loc:Loc Col_Name}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:ShellIconImage
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    IconSize="16"
                                                    Item="{Binding}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileBadgesTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="150"
                                    controls:GridViewSort.SortKey="Modified"
                                    Header="{loc:Loc Col_Modified}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="130"
                                    controls:GridViewSort.SortKey="Type"
                                    Header="{loc:Loc Col_Type}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Converter={StaticResource FileType}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="100"
                                    controls:GridViewSort.SortKey="Size"
                                    Header="{loc:Loc Col_Size}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FolderAwareSize}">
                                                        <Binding Path="Kind" />
                                                        <Binding Path="SizeBytes" />
                                                        <Binding Path="ComputedFolderSize" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!--  Rácsnézet  -->
                    <ListBox
                        x:Name="GridViewList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource FileTileStyle}"
                        ItemsSource="{Binding SelectedTab.Items}"
                        MouseDoubleClick="OnItemDoubleClick"
                        PreviewMouseRightButtonDown="OnEmptyAreaPreviewRightButtonDown"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Extended"
                        Visibility="Collapsed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingWrapPanel ItemWidth="116" ItemHeight="112" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                <StackPanel Width="104">
                                    <controls:ShellIconImage
                                        Width="48"
                                        Height="48"
                                        Margin="0,4,0,8"
                                        HorizontalAlignment="Center"
                                        IconSize="48"
                                        Item="{Binding}" />
                                    <TextBlock
                                        MaxHeight="34"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <ContentPresenter
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Center"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource FileBadgesTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        Üres mappa / hiba üzenet — csak lapos (Részletek/Rács)
                        nézetben, lásd TabViewModel.ShowFlatEmptyMessage: oszlopos
                        nézetben ugyanez az adat már minden oszlop saját
                        buborékjában megjelenik, enélkül duplán, egymásra
                        lebegve látszódna.
                    -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding SelectedTab.EmptyMessage}"
                        Visibility="{Binding SelectedTab.ShowFlatEmptyMessage, Converter={StaticResource BoolToVisibility}}" />

                    <ui:ProgressRing
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding SelectedTab.ShowFlatLoading, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        Húzásos (marquee) kijelölő téglalap. Nyugalomban
                        összecsukva; a MarqueeSelector (Controls/MarqueeSelector.cs)
                        húzás közben állítja a Margin/Width/Height-jét a
                        FileListHosthoz viszonyítva — lásd MainWindow.xaml.cs
                        konstruktorát, ahol a DetailsView-hoz és a
                        GridViewList-hez is hozzá van kötve.
                    -->
                    <Border
                        x:Name="MarqueeRectangle"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#3D60CDFF"
                        BorderBrush="#8060CDFF"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />

                    <!--
                        Oszlopos (Miller) nézet: minden Columns-beli elem egy
                        TabViewModel, ami a saját mappáját listázza — lásd
                        TabViewModel.Columns/SelectColumnItemAsync. A
                        kijelölés minden oszlopban OnColumnSelectionChanged-en
                        fut át (MainWindow.xaml.cs).
                    -->
                    <ItemsControl
                        x:Name="ColumnsHost"
                        ItemsSource="{Binding SelectedTab.Columns}"
                        Visibility="Collapsed">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Border
                                    Width="230"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,1,0">
                                    <Grid>
                                        <ListBox
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemContainerStyle="{StaticResource ColumnItemStyle}"
                                            ItemsSource="{Binding Items}"
                                            SelectionChanged="OnColumnSelectionChanged"
                                            SelectionMode="Single"
                                            VirtualizingPanel.IsVirtualizing="True">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:ShellIconImage
                                                            Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            IconSize="16"
                                                            Item="{Binding}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <ui:SymbolIcon
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Symbol="ChevronRight24"
                                                            Visibility="{Binding IsNavigable, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding EmptyMessage}"
                                            Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}" />

                                        <ui:ProgressRing
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>

                    <!--
                        Oszlopos nézet jobb oldali részletek panelje — csak
                        akkor látszik, ha egy oszlopban FÁJLT (nem mappát)
                        jelöltek ki, lásd TabViewModel.ColumnsSelectedFile.
                    -->
                    <Border
                        Grid.Column="1"
                        Width="240"
                        Padding="18"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding SelectedTab.ColumnsSelectedFile, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel DataContext="{Binding SelectedTab.ColumnsSelectedFile}">
                            <controls:ShellIconImage
                                Width="48"
                                Height="48"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Center"
                                IconSize="48"
                                Item="{Binding}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <Separator Margin="0,16,0,16" />

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc Col_Type}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding Converter={StaticResource FileType}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc Col_Size}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc Col_Modified}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!--  Állapotsor  -->
        <Border
            Grid.Row="4"
            Padding="18,6,18,10">
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SelectedTab.StatusText}" />
        </Border>
    </Grid>
</ui:FluentWindow>
