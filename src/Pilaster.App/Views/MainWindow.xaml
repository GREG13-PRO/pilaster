<ui:FluentWindow
    x:Class="Pilaster.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:fileOps="clr-namespace:Pilaster.App.Services.FileOperations"
    xmlns:fs="clr-namespace:Pilaster.Core.FileSystem;assembly=Pilaster.Core"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:metadata="clr-namespace:Pilaster.Core.Metadata;assembly=Pilaster.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Pilaster.App.Views"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="Pilaster"
    Width="1280"
    Height="820"
    MinWidth="720"
    MinHeight="480"
    d1p1:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Pilaster;component/Assets/app.ico"
    PreviewKeyDown="OnMainPreviewKeyDown"
    WindowBackdropType="{DynamicResource PilasterWindowBackdrop}"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>

        <!--
            Animációs időzítések. A belépés gyorsabb, mint a kilépés: a
            rámutatásra azonnali választ várunk, az elhagyás viszont lágyabban
            olvad ki, különben a lista villogónak hat gyors egérmozgásnál.
        -->
        <Duration x:Key="HoverInDuration">0:0:0.10</Duration>
        <Duration x:Key="HoverOutDuration">0:0:0.18</Duration>

        <!--  Kiemelés átúsztatással — a sorok, csempék és oldalsáv-elemek közös mintája  -->
        <Storyboard x:Key="FadeInHighlight">
            <DoubleAnimation
                Storyboard.TargetName="Hover"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="{StaticResource HoverInDuration}" />
        </Storyboard>
        <Storyboard x:Key="FadeOutHighlight">
            <DoubleAnimation
                Storyboard.TargetName="Hover"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="{StaticResource HoverOutDuration}" />
        </Storyboard>

        <!--
            Csúszó átmenet a fájlterületen, valahányszor a megnyitott mappa
            változik (gyorselérésre kattintás, breadcrumb, vissza/előre,
            dupla kattintás egy mappára). A CubicEase.EaseOut adja a
            "lelassuló becsapódás" érzetet, ami premium hatást kelt anélkül,
            hogy szaggatottnak hatna — lásd MainWindow.xaml.cs PlayContentTransition.
        -->
        <Duration x:Key="ContentSlideDuration">0:0:0.22</Duration>
        <Storyboard x:Key="SlideInFileArea">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="14"
                To="0"
                Duration="{DynamicResource ContentSlideDuration}">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0.4"
                To="1"
                Duration="{DynamicResource ContentSlideDuration}" />
        </Storyboard>

        <!--
            Egységes eszköztár-gomb: minden ikon-gomb (navigáció, létrehozás,
            overflow, téma, beállítások) azonos méretű, azonos lekerekítésű és
            azonos térközű — korábban minden gomb a WPF-UI alapértelmezett
            méretét kapta, ami finoman eltérő volt gombtípusonként.

            FONTOS: az ikont MINDIG a gomb közvetlen tartalmaként add meg
            (<ui:Button><ui:SymbolIcon .../></ui:Button>), NE a
            <ui:Button.Icon> tulajdonságon keresztül. Ez utóbbi ezen a
            WPF-UI verzión (4.3.0) néha teljesen üresen marad — sem
            képernyőn, sem RenderTargetBitmap-es önrenderelésnél nem jelenik
            meg semmi, miközben az önálló SymbolIcon megbízhatóan működik.
            Több elszigetelt próbaalkalmazással megerősítve.

            A háttér SAJÁT ControlTemplate-tel van kikényszerítve, nem a
            beépített Appearance="Transparent" tulajdonsággal: az utóbbi ezen
            a WPF-UI verzión alapállapotban is egy világos/szürke dobozt
            hagyott a gomb mögött (különösen feltűnő sötét témában), holott
            névleg átlátszót kellene adnia — feltehetően ugyanaz a fajta
            sablon-feloldási megbízhatatlanság, ami a Button.Icon hibáját is
            okozta. A saját sablon teljes kontrollt ad: nyugalmi állapotban
            garantáltan nincs háttér, az ikon a téma szövegszínét követi
            (nem hardcode-olt fehér), és csak rámutatáskor/lenyomáskor jelenik
            meg egy finom kiemelés.
        -->
        <Style x:Key="ToolbarButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="Pressed"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Fájlelemek helyi menüje. Egyetlen megosztott példány — mivel
            egyszerre csak egy nyílhat meg, ez biztonságosan újrahasználható a
            részletes és a rács nézet minden során/csempéjén. A DataContext
            explicit átirányítása kell, mert a ContextMenu popupként külön
            vizuális fában él, és nem örökli automatikusan a
            PlacementTarget adatkontextusát.
        -->
        <ContextMenu x:Key="FileItemContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnGlassContextMenuOpened">
            <MenuItem Click="OnOpenItemClick" Header="{loc:Loc Cmd_Open}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Click="OnPinToQuickAccessClick"
                Header="{loc:Loc Cmd_PinToQuickAccess}"
                Visibility="{Binding IsNavigable, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pin24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnCopyItemClick" Header="{loc:Loc Cmd_Copy}" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DocumentCopy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnCutItemClick" Header="{loc:Loc Cmd_Cut}" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Cut24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnCopyPathClick" Header="{loc:Loc Cmd_CopyPath}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnShowInExplorerClick" Header="{loc:Loc Cmd_ShowInExplorer}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnDeleteItemClick" Header="{loc:Loc Cmd_Delete}" InputGestureText="Del">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnShowPropertiesClick" Header="{loc:Loc Cmd_Properties}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!--
            Az üres terület helyi menüje. Elsődlegesen a VALÓDI Windows
            háttér-menü jelenik meg (NativeContextMenuService.ShowBackgroundAsync,
            hívva az OnEmptyAreaPreviewRightButtonDown kódból) — ez csak akkor
            nyílik meg kézzel, ha a natív menü valamiért nem elérhető. Nincs
            Setter Property="ContextMenu" a DetailsView/GridViewList-en, hogy
            a WPF automatikus megnyitása ne ütközzön a kézi hívással.
        -->
        <ContextMenu x:Key="EmptyAreaContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnGlassContextMenuOpened">
            <MenuItem Command="{Binding CreateNewFolderCommand}" Header="{loc:Loc Cmd_NewFolder}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CreateNewFileCommand}" Header="{loc:Loc Cmd_NewFile}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DocumentAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding PasteCommand}" Header="{loc:Loc Cmd_Paste}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ClipboardPaste24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding SelectedTab.RefreshCommand}" Header="{loc:Loc Cmd_Refresh}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Loc Cmd_SortBy}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowSort24" />
                </MenuItem.Icon>
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Name}" Tag="{x:Static fs:SortKey.Name}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Size}" Tag="{x:Static fs:SortKey.Size}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Type}" Tag="{x:Static fs:SortKey.Type}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Modified}" Tag="{x:Static fs:SortKey.Modified}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Created}" Tag="{x:Static fs:SortKey.Created}" />
                <MenuItem Click="OnSortByClick" Header="{loc:Loc Col_Accessed}" Tag="{x:Static fs:SortKey.Accessed}" />
            </MenuItem>
        </ContextMenu>

        <!--  Oldalsáv sor  -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedRowFocusVisual}" />
            <!--
                A téma szövegszíne, amit a sor ikonjai is örökölnek: egyedi szín
                nélküli ikonnál (pl. meghajtók) a HexToBrush nem ad értéket, és
                enélkül a ListBox rendszer-alapértelmezett FEKETE színét
                örökölték sötét témában is.
            -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="{DynamicResource TokenRowPadding}" />
            <Setter Property="Margin" Value="{DynamicResource TokenRowMargin}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!--
                G1 (v1.0.1): korábban nem volt explicit Height, a sor pusztán
                a tartalom (ikon+szöveg) magasságára zsugorodott — a
                TokenRowPadding mind a három sűrűségnél 0 függőleges
                paddingot ad, tehát a sűrűség-beállítás sem hatott rá. A
                TokenRowHeight-re kötve a "kényelmes" (alap) sűrűségben 32 px
                lesz (a kért 32–36 px tartomány alján), a "tömör" 24 px-en
                marad — pontosan a kért "maradjon a mostani szűkebb változat".
            -->
            <!--
                MinHeight, nem Height: a meghajtó-sorok tartalma (név +
                kihasználtság-sáv + szabad hely) magasabb egy sima sornál. A fix
                magasság ezt levágta — a szabad hely szövege el sem látszott, a
                sáv pedig kilógott a sorból, így a kijelölés-kiemelés és a szöveg
                „elcsúszva" látszott egymáshoz képest.
            -->
            <Setter Property="MinHeight" Value="{DynamicResource TokenRowHeight}" />
            <!--
                Húzás indítása: a gyorselérés sorai áthúzhatók egymásra az
                átrendezéshez (lásd OnSidebarItemPreviewMouseMove). Más
                szekciók (Meghajtók, Kedvencek) sorain is fut, de ott a
                MainWindowViewModel.ReorderQuickAccess csendben nem csinál
                semmit, mert az útvonal nincs a gyorselérés-listában.
            -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSidebarItemPreviewMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnSidebarItemPreviewMouseMove" />
            <!--  Jobbklikk-menü a soron: átnevezés, ikon, mozgatás, eltávolítás, szerkesztő (spec F5).  -->
            <EventSetter Event="MouseRightButtonUp" Handler="OnSidebarItemRightClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!--
                            Background="Transparent" a gyökér Griden: null hátér
                            mellett a WPF csak a gyerekelemek konkrét
                            tartalmán (szöveg glyph-jei, kitöltött ikon-terület)
                            hit-testel, a köztük lévő "üres" résekben a
                            kattintás átesne a sorra. Transparent ecsettel az
                            EGÉSZ sor területe kattinthatóvá válik.
                        -->
                        <Grid Background="Transparent">
                            <!--
                                G1 (v1.0.1): 4 px-es beljebb-kezdés mindkét
                                oldalon, 4 px lekerekítéssel — korábban a
                                kijelölés/hover szél-szélig ért, 7 px
                                sarokkerekítéssel.
                            -->
                            <Border
                                x:Name="Hover"
                                Margin="4,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Margin="4,0"
                                Background="{DynamicResource AccentSelectionBrush}"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border
                                x:Name="DropTarget"
                                Margin="4,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource SystemAccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <!--
                                Vékony akcentus-sáv a bal szélen — ez teszi
                                egyértelművé elsőre az aktuálisan megnyitott
                                mappát, a Windows 11 navigációs mintáját követve.
                                4 px-es margóval indul, hogy a most beljebb
                                kezdődő Selected/Hover lekerekített szélén
                                belül maradjon.
                            -->
                            <Border
                                x:Name="ActiveBar"
                                Width="3"
                                Margin="4,4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource SystemAccentBrush}"
                                CornerRadius="2"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                                <Setter TargetName="ActiveBar" Property="Opacity" Value="1" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <!--
                                            Kijelöléskor a kiemelés elhalványul-be, az akcentus-sáv
                                            középről „kinő" (a Setter adja a végállapotot, a
                                            FillBehavior="Stop" után is az marad).
                                        -->
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation
                                                Storyboard.TargetName="Selected"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.18" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveBar"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.1"
                                                To="1"
                                                Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>

                            <!--
                                Az aktuálisan megnyitott mappa ÉS annak minden őse
                                kiemelve (pl. "Dokumentumok" akkor is aktív, ha épp
                                egy almappájában vagyunk) — útvonal alapján, nem a
                                ListBox kijelölés-állapotán keresztül. Lásd
                                MainWindowViewModel.IsPathOrAncestor. (A fülsáv is
                                ezt a stílust használja, de a TabViewModelnek nincs
                                IsActive tulajdonsága, ezért ott a trigger
                                ártalmatlanul soha nem talál kötést.)
                            -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                                <Setter TargetName="ActiveBar" Property="Opacity" Value="1" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <!--
                                            Kijelöléskor a kiemelés elhalványul-be, az akcentus-sáv
                                            középről „kinő" (a Setter adja a végállapotot, a
                                            FillBehavior="Stop" után is az marad).
                                        -->
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation
                                                Storyboard.TargetName="Selected"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.18" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveBar"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.1"
                                                To="1"
                                                Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>

                            <!--  Fájlhúzás célja (lásd MainWindow.xaml.cs SetSidebarDropHighlight): accent keret + kiemelés.  -->
                            <Trigger Property="Tag" Value="DropTarget">
                                <Setter TargetName="DropTarget" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Oszlopfejléc. A beépített GridView a klasszikus WPF-témát hozza
            magával (világos háttér, sötét szöveg), ami sötét módban idegen
            testként ülne a felületen — ezért saját sablont kap.
        -->
        <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0">
                            <StackPanel
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="Arrow"
                                    Margin="6,1,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>

                            <!--  A rendezés iránya nyíllal, ahogy az Explorerben  -->
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Ascending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25B2;" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Descending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Helyben szerkeszthető névmező — új elem létrehozásakor azonnal
            (lásd MainWindowViewModel.CreateNewItemAsync → TabViewModel.BeginRename)
            vagy kézi átnevezéskor jelenik meg a statikus névTextBlock helyett.
            Közös sablon a Részletes és a Rácsnézet között.
        -->
        <DataTemplate x:Key="FileNameEditTemplate" DataType="{x:Type fs:FileSystemItem}">
            <ui:TextBox
                x:Name="RenameBox"
                MinWidth="80"
                Padding="3,0"
                VerticalAlignment="Center"
                IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                KeyDown="OnRenameBoxKeyDown"
                LostFocus="OnRenameBoxLostFocus"
                Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{Binding RenameError}">
                <ui:TextBox.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRenameError}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource TokenDanger}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:TextBox.Style>
            </ui:TextBox>
        </DataTemplate>

        <!--
            Címke-pöttyök + kedvenc szív + címke-választó ikon egy fájlsoron —
            közös sablon a Részletes és a Rácsnézet között (lásd
            OnTagPickerClick / SelectedTab.ToggleFavoriteCommand). A
            RelativeSource AncestorType=Control a legközelebbi Control ősre
            (ListViewItem VAGY ListBoxItem, nézettől függően) hivatkozik —
            ez teszi lehetővé, hogy ugyanaz a sablon mindkét nézetben
            hoverre jelenítse meg a gombokat.
        -->
        <DataTemplate x:Key="FileBadgesTemplate" DataType="{x:Type fs:FileSystemItem}">
            <StackPanel Orientation="Horizontal">
                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type metadata:TagDefinition}">
                            <!--  Lásd Controls/TagSwatch.cs — a méret itt kisebb, mert egy fájlsoron több is elfér egymás mellett.  -->
                            <controls:TagSwatch
                                Width="9"
                                Height="9"
                                Margin="2,0"
                                ColorHex="{Binding ColorHex}"
                                TagColor="{Binding Color}"
                                ToolTip="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button
                    Margin="4,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="OnTagPickerClick"
                    ToolTip="{loc:Loc Cmd_Tags}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="12" Symbol="Tag24" />
                </ui:Button>

                <ui:Button
                    Margin="2,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.SelectedTab.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    CommandParameter="{Binding}"
                    ToolTip="{loc:Loc Cmd_AddFavorite}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon FontSize="13" Filled="{Binding IsFavorite}" Symbol="Heart24">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TokenDanger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </StackPanel>
        </DataTemplate>

        <!--  Fájllista sor a részletes nézetben  -->
        <Style x:Key="FileRowStyle" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedRowFocusVisual}" />
            <Setter Property="Padding" Value="{DynamicResource TokenRowPadding}" />
            <Setter Property="Height" Value="{DynamicResource TokenRowHeight}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <!--
                Nincs Setter Property="ContextMenu" itt: a jobbklikket
                OnItemPreviewRightButtonDown kezeli, ami a VALÓDI Windows
                shell menüt hívja meg (NativeContextMenuService) — a
                FileItemContextMenu csak akkor nyílik meg kézzel, ha a
                natív menü valamiért nem elérhető.
            -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightButtonDown" />
            <EventSetter Event="MouseEnter" Handler="OnFileItemMouseEnter" />
            <!--  Mappa húzása a gyorselérésre — lásd OnFileRowPreviewMouseMove.  -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnFileRowPreviewMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnFileRowPreviewMouseMove" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!--  Background="Transparent": lásd a SidebarItemStyle megjegyzését.  -->
                        <Grid Margin="{DynamicResource TokenRowMargin}" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource TokenHover}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource AccentSelectionBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Csempe a rácsnézetben  -->
        <Style x:Key="FileTileStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedRowFocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <!--
                Nincs Setter Property="ContextMenu" itt: a jobbklikket
                OnItemPreviewRightButtonDown kezeli, ami a VALÓDI Windows
                shell menüt hívja meg (NativeContextMenuService) — a
                FileItemContextMenu csak akkor nyílik meg kézzel, ha a
                natív menü valamiért nem elérhető.
            -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightButtonDown" />
            <EventSetter Event="MouseEnter" Handler="OnFileItemMouseEnter" />
            <!--  Mappa húzása a gyorselérésre — lásd OnFileRowPreviewMouseMove.  -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnFileRowPreviewMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnFileRowPreviewMouseMove" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!--  Background="Transparent": lásd a SidebarItemStyle megjegyzését.  -->
                        <Grid Margin="4" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource AccentSelectionBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border Padding="6,10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sor egy oszlopos nézet oszlopában — a FileTileStyle könnyített, keret nélküli változata  -->
        <Style x:Key="ColumnItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedRowFocusVisual}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="4,1" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource AccentSelectionBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Címsorbeli fül (Windows 11 Intéző-stílus): felül lekerekített, a
            kijelölt fül az eszköztár-sáv színét kapja és összeolvad vele.
            Bezáró „x" a kijelölt és a rámutatott fülön; középső kattintás is
            bezár (OnTitleTabMouseUp). Új fül megjelenésekor rövid beúszás.
        -->
        <Style x:Key="TitleTabStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseUp" Handler="OnTitleTabMouseUp" />
            <EventSetter Event="Loaded" Handler="OnTitleTabLoaded" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Chrome"
                            Padding="12,0,6,0"
                            Background="Transparent"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="15">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Folder24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHome}" Value="True">
                                                    <Setter Property="Symbol" Value="Home24" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                    <Setter Property="Symbol" Value="Delete24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding CurrentPath}" />
                                <ui:Button
                                    x:Name="CloseButton"
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="OnTitleTabCloseClick"
                                    Opacity="0"
                                    ToolTip="{loc:Loc Cmd_CloseTab}">
                                    <ui:SymbolIcon FontSize="11" Symbol="Dismiss24" />
                                </ui:Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassPanelBrush}" />
                                <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Oldalsáv görgetése: vékony, a tartalom FÖLÖTT lebegő görgetősáv a
            jobb szélen, ami csak akkor jelenik meg, ha az egér az oldalsáv
            fölött van (Windows 11 minta). A szokásos sablon külön oszlopot
            foglalt neki, így a szekciók nyilai mellé szorult, és zavaróan
            középen látszott (felhasználói visszajelzés).
        -->
        <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Margin="0,10,1,10"
                                HorizontalAlignment="Right"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Opacity="0"
                                Orientation="Vertical"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PART_VerticalScrollBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                BeginTime="0:0:0.6"
                                                Storyboard.TargetName="PART_VerticalScrollBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Az ablak alapja üveghatásnál (lásd GlassEffectService.ApplyBrushes):
            sötétben átlátszó, világosban fehéres tónus, hogy a színes
            asztalháttér ne üssön át tarkán a panelek közötti réseken. Külön
            réteg, mert a WPF-UI az Acrylic bekapcsolásakor az ablak saját
            hátterét átlátszóra állítja.
        -->
        <Border Grid.RowSpan="5" Background="{DynamicResource GlassWindowBrush}" />

        <!--
            Címsor — a Windows 11 Intézőhöz hasonlóan a FÜLEK a címsorban
            vannak (egypaneles nézetben mindig, egy fülnél is), a végükön
            „+" gombbal. A WPF-UI TitleBar a Header-ben lévő, kattintható
            elemeket (fülek, gombok) kliensterületként kezeli, a köztük és
            mellettük lévő üres rész továbbra is az ablak mozgatására szolgál.
            Kétpaneles nézetben minden panel a saját fülsávját rajzolja (lásd
            FilePaneView), ezért ott a címsorban csak a program neve látszik.
        -->
        <ui:TitleBar
            Grid.Row="0"
            Height="44"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Header>
                <Grid>
                    <!--  Kétpaneles nézet: ikon + név  -->
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal"
                        Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}}">
                        <Image
                            Width="16"
                            Height="16"
                            Margin="0,0,10,0"
                            Source="pack://application:,,,/Pilaster;component/Assets/app-icon.png" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="Pilaster" />
                    </StackPanel>

                    <!--  Egypaneles nézet: ikon + fülek + új fül  -->
                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Image
                            Width="16"
                            Height="16"
                            Margin="14,0,10,11"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Source="pack://application:,,,/Pilaster;component/Assets/app-icon.png" />
                        <ListBox
                            x:Name="TitleTabStrip"
                            VerticalAlignment="Bottom"
                            Background="{x:Null}"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource TitleTabStyle}"
                            ItemsSource="{Binding Tabs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <ui:Button
                            Width="32"
                            Height="30"
                            Margin="4,0,0,3"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            Appearance="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{Binding NewTabCommand}"
                            ToolTip="{loc:Loc Cmd_NewTabTooltip}">
                            <ui:SymbolIcon FontSize="16" Symbol="Add24" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!--
            Felső sáv — „liquid glass" háttér az eszköztár mögött. A kijelölt
            fül ugyanezt az ecsetet kapja, így — mint az Intézőben — a fül és
            a sáv egy összefüggő felületnek látszik.
        -->
        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="10,0,10,6"
            Background="{DynamicResource GlassPanelBrush}"
            CornerRadius="12" />

        <!--  Eszköztár: navigáció, útvonalsáv, keresés, nézetváltó  -->
        <!--  A sáv hátterével (10) és az alatta lévő oldalsávval/fájlterülettel egy vonalban, 6 DIP belső térrel.  -->
        <Grid Grid.Row="2" Margin="16,7,16,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Navigáció + útvonalsáv: csak EGYPANELES nézetben — kétpaneles
                nézetben mindkét panel a saját vissza/előre/fel/frissítés
                gombjait és breadcrumbját rajzolja (lásd FilePaneView.xaml),
                úgyhogy ez a felső, „SelectedTab"-ra kötött másolat felesleges
                lenne ott.
            -->
            <StackPanel
                Grid.Column="0"
                Margin="0,0,8,0"
                Orientation="Horizontal"
                Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <ui:Button
                    Command="{Binding SelectedTab.GoBackCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoBack}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Back}">
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding SelectedTab.GoForwardCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoForward}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Forward}">
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding SelectedTab.GoUpCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoUp}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Up}">
                    <ui:SymbolIcon Symbol="ArrowUp24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding SelectedTab.RefreshCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Refresh}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button>

                <!--
                    Lomtár ürítése — csak Lomtár-nézetben látszik (lásd
                    TabViewModel.IsRecycleBin). Külön Click-kezelő, mert a
                    tényleges ürítés előtt megerősítést kér — lásd
                    OnEmptyRecycleBinToolbarClick.
                -->
                <ui:Button
                    Click="OnEmptyRecycleBinToolbarClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_EmptyRecycleBin}"
                    Visibility="{Binding SelectedTab.IsRecycleBin, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>

                <!--
                    Kiadás — csak akkor látszik, ha az aktív fül jelenlegi
                    mappája cserélhető vagy optikai meghajtón van. Lásd
                    MainWindowViewModel.CanEjectCurrentDrive és
                    Pilaster.Shell.Devices.RemovableDriveService.
                -->
                <ui:Button
                    Command="{Binding EjectCurrentDriveCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Eject}"
                    Visibility="{Binding CanEjectCurrentDrive, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ArrowEject20" />
                </ui:Button>

                <Rectangle
                    Width="1"
                    Margin="6,7"
                    Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!--  Két testreszabható gyorsgomb — a viselkedésük a Beállításokban állítható  -->
                <ui:Button
                    Command="{Binding RunQuickActionCommand}"
                    CommandParameter="1"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{Binding QuickAction1Label}">
                    <ui:SymbolIcon Symbol="{Binding QuickAction1Icon}" />
                </ui:Button>
                <ui:Button
                    Command="{Binding RunQuickActionCommand}"
                    CommandParameter="2"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{Binding QuickAction2Label}">
                    <ui:SymbolIcon Symbol="{Binding QuickAction2Icon}" />
                </ui:Button>
            </StackPanel>

            <!--
                Útvonalsáv. Kattintás az üres területére (nem egy szegmensre)
                szerkeszthető szövegmezőre vált — lásd
                OnBreadcrumbAreaPreviewLeftButtonDown — mint az Intézőben.
            -->
            <Border
                Grid.Column="1"
                Padding="7,4"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PreviewMouseLeftButtonDown="OnBreadcrumbAreaPreviewLeftButtonDown"
                Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="{Binding SelectedTab.IsEditingPath, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{Binding SelectedTab.Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            Padding="7,3"
                                            Appearance="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.OpenBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}">
                                            <Grid>
                                                <ui:SymbolIcon
                                                    FontSize="14"
                                                    Symbol="Home24"
                                                    ToolTip="{Binding Label}"
                                                    Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Label}" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </Grid>
                                        </ui:Button>
                                        <ui:SymbolIcon
                                            Margin="1,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Symbol="ChevronRight24" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ui:TextBox
                        x:Name="PathEditBox"
                        Grid.Column="0"
                        Padding="4,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        IsVisibleChanged="OnPathEditBoxIsVisibleChanged"
                        KeyDown="OnPathEditBoxKeyDown"
                        LostFocus="OnPathEditBoxLostFocus"
                        Text="{Binding SelectedTab.EditablePathText, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding SelectedTab.IsEditingPath, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Loc Path_Copied}"
                        Visibility="{Binding SelectedTab.PathCopied, Converter={StaticResource BoolToVisibility}}" />

                    <ui:Button
                        Grid.Column="2"
                        Padding="5"
                        Appearance="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{Binding SelectedTab.CopyPathCommand}"
                        ToolTip="{loc:Loc Cmd_CopyPath}">
                        <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                    </ui:Button>
                </Grid>
            </Border>

            <!--
                Kétpaneles nézet parancssávja: a panelek saját navigációja
                mellett itt a panelek KÖZÖTTI műveletek vannak (másolás és
                áthelyezés a másik panelre, szinkronizálás, csere) — korábban
                ez a rész üresen maradt.
            -->
            <StackPanel
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Click="OnDualNewFolderClick" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Cmd_NewFolder}">
                    <ui:SymbolIcon Symbol="FolderAdd24" />
                </ui:Button>
                <ui:Button Click="OnDualNewFileClick" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Cmd_NewFile}">
                    <ui:SymbolIcon Symbol="DocumentAdd24" />
                </ui:Button>
                <Rectangle Width="1" Margin="6,7" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <ui:Button Width="Auto" Padding="8,0" Click="OnDualCopyClick" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Dual_CopyTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" />
                        <TextBlock Margin="6,0,2,0" VerticalAlignment="Center" FontSize="12" Text="{loc:Loc Dual_Copy}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Width="Auto" Padding="8,0" Click="OnDualMoveClick" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Dual_MoveTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowForward24" />
                        <TextBlock Margin="6,0,2,0" VerticalAlignment="Center" FontSize="12" Text="{loc:Loc Dual_Move}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Click="OnDualDeleteClick" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Dual_DeleteTooltip}">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>
                <Rectangle Width="1" Margin="6,7" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <ui:Button Command="{Binding SyncPanesCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Cmd_SyncPanes}">
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button>
                <ui:Button Click="OnSwapPanesClick" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{loc:Loc Cmd_SwapPanes}">
                    <ui:SymbolIcon Symbol="ArrowSwap24" />
                </ui:Button>
            </StackPanel>

            <ui:TextBox
                x:Name="QuickFilterBox"
                Grid.Column="2"
                Width="260"
                Margin="10,0,10,0"
                Padding="8,6,8,3"
                VerticalContentAlignment="Center"
                PlaceholderText="{loc:Loc Search_Placeholder}"
                Text="{Binding SelectedTab.QuickFilterText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!--
                Rendezés és Nézet: két legördülő gomb, mint a Windows 11
                Intéző parancssávján — almenü nélküli, lapos menükkel. A
                korábbi „⋯" menü almenüi rámutatásra nem nyíltak, és dupla
                kerettel jelentek meg (felhasználói hibajelentés).
            -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button
                    Width="Auto"
                    Padding="8,0"
                    Click="OnSortMenuClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_SortBy}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSort24" />
                        <ui:SymbolIcon Margin="3,0,0,0" FontSize="10" Symbol="ChevronDown24" />
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    Width="Auto"
                    Padding="8,0"
                    Click="OnViewMenuClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc View_Mode}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Grid24" />
                        <ui:SymbolIcon Margin="3,0,0,0" FontSize="10" Symbol="ChevronDown24" />
                    </StackPanel>
                </ui:Button>

                <!--  Egyablakos / Kétablakos (kétpaneles) nézet váltása — az ikon két egymás melletti panel  -->
                <ui:Button
                    Appearance="{Binding DualPaneEnabled, Converter={StaticResource DualPaneAppearance}}"
                    Click="OnToggleDualPaneClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_ToggleDualPaneTooltip}">
                    <ui:SymbolIcon Symbol="SplitVertical24" />
                </ui:Button>

                <!--  Téma-kapcsoló: az ikon azt mutatja, amire váltani fog  -->
                <ui:Button
                    Command="{Binding ToggleThemeCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_ToggleTheme}">
                    <ui:SymbolIcon Symbol="{Binding ThemeIcon}" />
                </ui:Button>

                <ui:Button
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="{loc:Loc Cmd_Settings}">
                    <ui:SymbolIcon Symbol="Settings24" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <!--  Tartalom: frissítés-sáv + oldalsáv + fájllista  -->
        <Grid Grid.Row="3" Margin="10,0,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Frissítés-sáv. Nem tolakodó: csak akkor jelenik meg, ha van
                elérhető új verzió, és bármikor elvethető — lásd
                UpdateViewModel és Diagnostics/GitHubUpdateService.
            -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="14,9"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding Updates.IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Symbol="ArrowDownload24" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{Binding Updates.BannerText}" />

                    <ui:ProgressRing
                        Grid.Column="2"
                        Width="16"
                        Height="16"
                        Margin="0,0,10,0"
                        IsIndeterminate="True"
                        Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        Appearance="Primary"
                        Command="{Binding Updates.InstallUpdateCommand}"
                        Content="{loc:Loc Update_Action}"
                        Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <ui:Button
                        Grid.Column="3"
                        Command="{Binding Updates.DismissBannerCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{loc:Loc Cmd_Dismiss}">
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Oldalsáv — „liquid glass": GlassEffectService.ApplyInitial/SetEnabled kapcsolja GlassPanelBrush-t áttetsző/átlátszatlan között  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer Padding="0,8" controls:SmoothScroll.IsEnabled="True" Style="{StaticResource OverlayScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SidebarSection}">
                                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                    <!--
                                        Kattintható fejléc: bal kattintásra a szekció össze-/
                                        kicsukódik (ToggleExpandedCommand), a nyíl a Windows 11
                                        Intéző csoportosított oldalsávjának mintáját követve
                                        forog. A jobbklikk nyitja a gyorselérés-szerkesztőt
                                        (spec F5) — a menü csak a Gyorselérés szekcióban
                                        jelenik meg, a Tag adja át a szekció kulcsát.
                                    -->
                                    <!--
                                        A WPF-UI Button Transparent megjelenésben is 1px-es
                                        (világos) keretet rajzol — a fejlécnek nem gomb-, hanem
                                        feliratszerű kinézet kell, ezért a keret nulla.
                                    -->
                                    <ui:Button
                                        Padding="12,11,10,7"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Appearance="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ToggleExpandedCommand}"
                                        MouseRightButtonUp="OnSidebarHeaderRightClick"
                                        Tag="{Binding HeaderKey}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TokenTextMuted}"
                                                Text="{Binding Header}" />
                                            <ui:SymbolIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TokenTextMuted}"
                                                RenderTransformOrigin="0.5,0.5"
                                                Symbol="ChevronDown24">
                                                <ui:SymbolIcon.RenderTransform>
                                                    <!--  Alapból kinyitva → felfelé mutat (Windows 11 Intéző mintája); csukva lefelé.  -->
                                                    <RotateTransform x:Name="ChevronRotate" Angle="180" />
                                                </ui:SymbolIcon.RenderTransform>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </ui:Button>
                                    <ListBox
                                        AllowDrop="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DragLeave="OnSidebarDragLeave"
                                        DragOver="OnSidebarDragOver"
                                        Drop="OnSidebarDrop"
                                        ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                        ItemsSource="{Binding Items}"
                                        SelectionChanged="OnSidebarSelectionChanged"
                                        SelectionMode="Single"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                                                <StackPanel Opacity="{Binding IsMissing, Converter={StaticResource HiddenOpacity}}">
                                                    <!--  Csoportfejléc a sor FÖLÖTT — a gyorselérés-szerkesztőben adható meg.  -->
                                                    <TextBlock
                                                        Margin="4,8,0,3"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TokenTextMuted}"
                                                        Text="{Binding GroupHeader}"
                                                        Visibility="{Binding HasGroupHeader, Converter={StaticResource BoolToVisibility}}" />

                                                    <!--  Elválasztó sor: csak vonal, felirat és ikon nélkül.  -->
                                                    <Rectangle
                                                        Height="1"
                                                        Margin="2,5"
                                                        Fill="{DynamicResource TokenBorder}"
                                                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}}" />

                                                    <Grid Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <!--
                                                                Behelyezett optikai lemeznél a saját
                                                                ikonja (autorun.inf/.ico) az általános
                                                                glyph helyett — lásd
                                                                SidebarItemViewModel.CustomIcon és
                                                                DiscIconResolver.
                                                            -->
                                                            <ui:SymbolIcon
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="18"
                                                                Foreground="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                                                Symbol="{Binding Icon}"
                                                                Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                            <!--
                                                                20 DIP — a MainWindowViewModel.QuickAccessIconSize-zal
                                                                egyezően, pontosan ekkora fizikai pixelméretben kért
                                                                képpel, hogy 1:1-ben (átméretezés nélkül) rajzolódjon.
                                                                A 20+10 margó ugyanannyi helyet foglal, mint a glyph
                                                                18+12-je, így a feliratok egy vonalban maradnak.
                                                                A UseLayoutRounding nélkül fél pixelre is eshetne,
                                                                ami ugyanúgy elmosná.
                                                            -->
                                                            <Image
                                                                Width="20"
                                                                Height="20"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                                SnapsToDevicePixels="True"
                                                                UseLayoutRounding="True"
                                                                Source="{Binding CustomIcon}"
                                                                Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Text="{Binding Label}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <!--
                                                                Figyelmeztető ikon a nem elérhető útvonalaknál. A sor
                                                                SZÁNDÉKOSAN nem tűnik el magától (spec F5): a
                                                                jobbklikk-menüből javítható vagy eltávolítható.
                                                            -->
                                                            <ui:SymbolIcon
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TokenWarning}"
                                                                Symbol="Warning24"
                                                                ToolTip="{loc:Loc QuickAccess_Unreachable}"
                                                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />

                                                            <!--
                                                                Az „x" gomb: a Kedvencek szekció sorain. A rögzített
                                                                gyorselérés-sorokon szándékosan NINCS — azokat a
                                                                szerkesztőből lehet eltávolítani, hogy egy
                                                                félrekattintás ne tüntessen el kézzel felvett mappát.
                                                            -->
                                                            <ui:Button
                                                                Padding="4"
                                                                VerticalAlignment="Center"
                                                                Appearance="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{loc:Loc Cmd_RemoveFavorite}"
                                                                Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}">
                                                                <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                                                            </ui:Button>

                                                            <!--
                                                                Leoldás-tű: a rögzített gyorselérés-sorokon, csak
                                                                rámutatáskor/kijelölve (spec: oldalsáv-redesign,
                                                                a referenciakép mintája) — nem állandó „x", hogy a
                                                                korábbi véletlen-kattintás elleni óvatosság megmaradjon,
                                                                mégis egy kattintással leoldható legyen jobbklikk nélkül is.
                                                            -->
                                                            <ui:Button
                                                                Padding="4"
                                                                VerticalAlignment="Center"
                                                                Appearance="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.UnpinQuickAccessCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{loc:Loc Cmd_UnpinQuickAccess}"
                                                                Visibility="{Binding IsUnpinnable, Converter={StaticResource BoolToVisibility}}">
                                                                <ui:Button.Style>
                                                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                                <ui:SymbolIcon FontSize="12" Symbol="Pin24" />
                                                            </ui:Button>

                                                            <!--  Kiadás — csak cserélhető/optikai meghajtóknál, sosem a rendszermeghajtónál (CanEject)  -->
                                                            <ui:Button
                                                                Padding="4"
                                                                VerticalAlignment="Center"
                                                                Appearance="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.EjectDriveCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{loc:Loc Cmd_Eject}"
                                                                Visibility="{Binding CanEject, Converter={StaticResource BoolToVisibility}}">
                                                                <ui:SymbolIcon FontSize="14" Symbol="ArrowEject20" />
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  Meghajtóknál kihasználtság-sáv  -->
                                                    <!--
                                                        Csak ha van mit mutatni (Detail) — egy üres
                                                        optikai meghajtónál nincs méretadat, ott egy
                                                        üres sáv és egy üres sor maradt volna.
                                                    -->
                                                    <StackPanel
                                                        Margin="30,4,4,6"
                                                        Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}">
                                                        <ProgressBar
                                                            Height="3"
                                                            Maximum="1"
                                                            Value="{Binding UsedFraction, Mode=OneWay}" />
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <!--  Nyíl-forgatás a szekció össze-/kicsukásakor — ugyanaz a lágy időzítés, mint a sorok hover-átúsztatásánál.  -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="ChevronRotate"
                                                        Storyboard.TargetProperty="Angle"
                                                        To="0"
                                                        Duration="{StaticResource HoverOutDuration}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="ChevronRotate"
                                                        Storyboard.TargetProperty="Angle"
                                                        To="180"
                                                        Duration="{StaticResource HoverInDuration}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Címkék szekció — külön az ItemsControl-tól, mert nem
                        navigál, hanem az aktuális fül nézetét szűri (lásd
                        MainWindowViewModel.SelectTagFilterCommand /
                        TabViewModel.ActiveTagFilterId). Csak akkor jelenik
                        meg, ha van legalább egy létrehozott címke.
                    -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock
                            Margin="16,6,12,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{loc:Loc Nav_Tags}" />
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
                                    <ui:Button
                                        Padding="12,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Appearance="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SelectTagFilterCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Appearance" Value="Secondary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:TagSwatch
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                ColorHex="{Binding ColorHex}"
                                                TagColor="{Binding Color}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                Background="Transparent" />

            <!--
                Fájlterület. A RenderTransform a SlideInFileArea storyboard
                célpontja — mappaváltáskor a MainWindow.xaml.cs
                PlayContentTransition indítja el, lásd a TrackTab-et.
            -->
            <Border
                x:Name="FileAreaBorder"
                Grid.Column="2"
                Background="{DynamicResource GlassSurfaceBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                RenderTransformOrigin="0.5,0.5"
                Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FileListHost" Grid.Column="0" PreviewKeyDown="OnFileListHostPreviewKeyDown">

                    <!--  Részletes nézet  -->
                    <ListView
                        x:Name="DetailsView"
                        controls:SmoothScroll.IsEnabled="True"
                        Background="Transparent"
                        BorderThickness="0"
                        GridViewColumnHeader.Click="OnColumnHeaderClick"
                        ItemContainerStyle="{StaticResource FileRowStyle}"
                        ItemsSource="{Binding SelectedTab.Items}"
                        MouseDoubleClick="OnItemDoubleClick"
                        PreviewMouseRightButtonDown="OnEmptyAreaPreviewRightButtonDown"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Extended"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView x:Name="DetailsGridView" ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                                <GridViewColumn
                                    Width="380"
                                    controls:GridViewSort.SortKey="Name"
                                    Header="{loc:Loc Col_Name}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                    <controls:ShellIconImage
                                                        IconSize="16"
                                                        Item="{Binding}"
                                                        Visibility="{Binding IsRecycled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                    <!--
                                                        Lomtár-elem: nincs valódi útvonal, tehát nincs
                                                        natív shell-ikon sem (lásd ShellImageService.
                                                        GetImageAsync IsRecycled ága) — helyette egyszerű
                                                        mappa/dokumentum szimbólum.
                                                    -->
                                                    <ui:SymbolIcon
                                                        FontSize="16"
                                                        Symbol="Document24"
                                                        Visibility="{Binding IsRecycled, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Directory">
                                                                        <Setter Property="Symbol" Value="Folder24" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Grid>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <!--  Rekurzív keresés találatánál: hol van (a keresett mappához képest).  -->
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding SearchLocationDisplay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding SearchLocationDisplay, Converter={StaticResource NullToCollapsed}}" />
                                                <ContentPresenter
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource FileNameEditTemplate}"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileBadgesTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="150"
                                    controls:GridViewSort.SortKey="Modified"
                                    Header="{loc:Loc Col_Modified}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="130"
                                    controls:GridViewSort.SortKey="Type"
                                    Header="{loc:Loc Col_Type}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Converter={StaticResource FileType}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="100"
                                    controls:GridViewSort.SortKey="Size"
                                    Header="{loc:Loc Col_Size}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FolderAwareSize}">
                                                        <Binding Path="Kind" />
                                                        <Binding Path="SizeBytes" />
                                                        <Binding Path="ComputedFolderSize" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!--  Opcionális oszlopok — a Beállítások → Fájllista → Extra oszlopok szerint (ApplyOptionalColumns).  -->
                                <GridViewColumn
                                    x:Name="CreatedColumn"
                                    Width="150"
                                    controls:GridViewSort.SortKey="Created"
                                    Header="{loc:Loc Col_Created}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding CreatedUtc, Converter={StaticResource LocalDate}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    x:Name="AccessedColumn"
                                    Width="150"
                                    controls:GridViewSort.SortKey="Accessed"
                                    Header="{loc:Loc Col_Accessed}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding AccessedUtc, Converter={StaticResource LocalDate}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!--  Rácsnézet  -->
                    <ListBox
                        x:Name="GridViewList"
                        controls:SmoothScroll.IsEnabled="True"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource FileTileStyle}"
                        ItemsSource="{Binding SelectedTab.Items}"
                        MouseDoubleClick="OnItemDoubleClick"
                        PreviewMouseRightButtonDown="OnEmptyAreaPreviewRightButtonDown"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Extended"
                        Visibility="Collapsed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingWrapPanel ItemWidth="116" ItemHeight="112" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                <StackPanel Width="104">
                                    <controls:ShellIconImage
                                        Width="48"
                                        Height="48"
                                        Margin="0,4,0,8"
                                        HorizontalAlignment="Center"
                                        IconSize="48"
                                        Item="{Binding}" />
                                    <TextBlock
                                        MaxHeight="34"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding DisplayName}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <ContentPresenter
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource FileNameEditTemplate}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
                                    <ContentPresenter
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Center"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource FileBadgesTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        Üres mappa / hiba üzenet — csak lapos (Részletek/Rács)
                        nézetben, lásd TabViewModel.ShowFlatEmptyMessage: oszlopos
                        nézetben ugyanez az adat már minden oszlop saját
                        buborékjában megjelenik, enélkül duplán, egymásra
                        lebegve látszódna.
                    -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding SelectedTab.EmptyMessage}"
                        Visibility="{Binding SelectedTab.ShowFlatEmptyMessage, Converter={StaticResource BoolToVisibility}}" />

                    <ui:ProgressRing
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding SelectedTab.ShowFlatLoading, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        Húzásos (marquee) kijelölő téglalap. Nyugalomban
                        összecsukva; a MarqueeSelector (Controls/MarqueeSelector.cs)
                        húzás közben állítja a Margin/Width/Height-jét a
                        FileListHosthoz viszonyítva — lásd MainWindow.xaml.cs
                        konstruktorát, ahol a DetailsView-hoz és a
                        GridViewList-hez is hozzá van kötve.
                    -->
                    <Border
                        x:Name="MarqueeRectangle"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource MarqueeFillBrush}"
                        BorderBrush="{DynamicResource MarqueeStrokeBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />

                    <!--
                        Oszlopos (Miller) nézet: minden Columns-beli elem egy
                        TabViewModel, ami a saját mappáját listázza — lásd
                        TabViewModel.Columns/SelectColumnItemAsync. A
                        kijelölés minden oszlopban OnColumnSelectionChanged-en
                        fut át (MainWindow.xaml.cs).
                    -->
                    <ItemsControl
                        x:Name="ColumnsHost"
                        ItemsSource="{Binding SelectedTab.Columns}"
                        Visibility="Collapsed">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Border
                                    Width="230"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,1,0">
                                    <Grid>
                                        <ListBox
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemContainerStyle="{StaticResource ColumnItemStyle}"
                                            ItemsSource="{Binding Items}"
                                            SelectionChanged="OnColumnSelectionChanged"
                                            SelectionMode="Single"
                                            VirtualizingPanel.IsVirtualizing="True">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:ShellIconImage
                                                            Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            IconSize="16"
                                                            Item="{Binding}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <ui:SymbolIcon
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Symbol="ChevronRight24"
                                                            Visibility="{Binding IsNavigable, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding EmptyMessage}"
                                            Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}" />

                                        <ui:ProgressRing
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Kezdőlap-panel — „Ez a gép" stílusban: gyorselérés-
                        mappák és meghajtók nagy csempékként, saját dizájnnal.
                        Csak akkor látszik, ha a fül a virtuális Kezdőlap-
                        nézetet mutatja (TabViewModel.IsHome) — lásd
                        MainWindow.xaml.cs SyncViewModeVisuals.
                    -->
                    <ScrollViewer
                        x:Name="HomeDashboard"
                        controls:SmoothScroll.IsEnabled="True"
                        Padding="6"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="4,4,0,10"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{loc:Loc Nav_QuickAccess}" />
                            <ItemsControl ItemsSource="{Binding HomeQuickAccessItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                                        <ui:Button
                                            Width="130"
                                            Height="92"
                                            Margin="0,0,10,10"
                                            Padding="0"
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.OpenSidebarItemCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            CornerRadius="9"
                                            Visibility="{Binding IsDashboardTile, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon
                                                    HorizontalAlignment="Center"
                                                    FontSize="28"
                                                    Symbol="{Binding Icon}" />
                                                <TextBlock
                                                    Margin="0,10,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding Label}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="4,16,0,10"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{loc:Loc Nav_Drives}" />
                            <ItemsControl ItemsSource="{Binding HomeDriveItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                                        <ui:Button
                                            Width="230"
                                            Margin="0,0,12,12"
                                            Padding="14,12"
                                            HorizontalContentAlignment="Stretch"
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.OpenSidebarItemCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            CornerRadius="9">
                                            <StackPanel HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="20"
                                                        Symbol="{Binding Icon}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ProgressBar
                                                    Height="4"
                                                    Margin="0,10,0,4"
                                                    Maximum="1"
                                                    Value="{Binding UsedFraction, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Detail}" />
                                            </StackPanel>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>

                    <!--
                        Oszlopos nézet jobb oldali részletek panelje — csak
                        akkor látszik, ha egy oszlopban FÁJLT (nem mappát)
                        jelöltek ki, lásd TabViewModel.ColumnsSelectedFile.
                    -->
                    <Border
                        Grid.Column="1"
                        Width="240"
                        Padding="18"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding SelectedTab.ColumnsSelectedFile, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel DataContext="{Binding SelectedTab.ColumnsSelectedFile}">
                            <controls:ShellIconImage
                                Width="48"
                                Height="48"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Center"
                                IconSize="48"
                                Item="{Binding}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <Separator Margin="0,16,0,16" />

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc Col_Type}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding Converter={StaticResource FileType}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc Col_Size}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{loc:Loc Col_Modified}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--
                Kétablakos (kétpaneles) nézet — a fülrendszertől
                FÜGGETLEN két panel (LeftPaneTab/RightPaneTab), csak akkor
                látszik, ha a felhasználó bekapcsolta. Lásd FilePaneView.
            -->
            <Grid
                x:Name="DualPaneHost"
                Grid.Column="2"
                Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="DualPaneGrid"
                    Grid.Row="0"
                    SizeChanged="OnDualPaneSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DualPaneLeftColumn" Width="*" />
                        <ColumnDefinition x:Name="DualPaneSplitterColumn" Width="Auto" />
                        <ColumnDefinition x:Name="DualPaneRightColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="DualPaneTopRow" Height="*" />
                        <RowDefinition x:Name="DualPaneSplitterRow" Height="Auto" />
                        <RowDefinition x:Name="DualPaneBottomRow" Height="*" />
                    </Grid.RowDefinitions>

                    <views:FilePaneView
                        x:Name="LeftPaneView"
                        Grid.Column="0"
                        Grid.Row="0"
                        Activated="OnLeftPaneActivated"
                        DataContext="{Binding LeftPane}"
                        DeleteRequested="OnPaneDeleteRequested"
                        FilesDropped="OnPaneFilesDropped" />

                    <GridSplitter
                        x:Name="DualPaneSplitter"
                        Grid.Column="1"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Width="6"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        MouseDoubleClick="OnDualPaneSplitterDoubleClick" />

                    <views:FilePaneView
                        x:Name="RightPaneView"
                        Grid.Column="2"
                        Grid.Row="0"
                        Activated="OnRightPaneActivated"
                        DataContext="{Binding RightPane}"
                        DeleteRequested="OnPaneDeleteRequested"
                        FilesDropped="OnPaneFilesDropped" />

                </Grid>

                <!--
                    Közös állapotsor (spec K7, v1.0.1): panelenkénti sor
                    helyett EGY, a két panel alatt, az AKTÍV panel adataival
                    — ez nem visz el annyi függőleges helyet, mint kettő
                    külön sor tenné.
                -->
                <Border
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    Padding="10,4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ActivePane.ActiveTab.StatusText}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding ActivePane.ActiveTab.CurrentPath, Converter={StaticResource DriveFreeSpace}}" />
                    </Grid>
                </Border>

                <!--
                    Diszkrét funkcióbillentyű-sáv — kattintható megfelelője a
                    Pilaster Classic billentyűkiosztásnak (lásd MainWindow.xaml.cs
                    OnMainPreviewKeyDown), csak akkor látszik, ha a felhasználó
                    mindkettőt (kétablakos nézet + a billentyűkiosztás) bekapcsolta.
                -->
                <Border
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding ShowFunctionKeyBar, Converter={StaticResource BoolToVisibility}}">
                    <UniformGrid Columns="6" Rows="1">
                        <ui:Button
                            Margin="2"
                            Click="OnFKeyViewClick"
                            Content="{loc:Loc FKey_View}" />
                        <ui:Button
                            Margin="2"
                            Click="OnFKeyEditClick"
                            Content="{loc:Loc FKey_Edit}" />
                        <ui:Button
                            Margin="2"
                            Click="OnFKeyCopyClick"
                            Content="{loc:Loc FKey_Copy}" />
                        <ui:Button
                            Margin="2"
                            Click="OnFKeyMoveClick"
                            Content="{loc:Loc FKey_Move}" />
                        <ui:Button
                            Margin="2"
                            Click="OnFKeyNewFolderClick"
                            Content="{loc:Loc FKey_NewFolder}" />
                        <ui:Button
                            Margin="2"
                            Click="OnFKeyDeleteClick"
                            Content="{loc:Loc FKey_Delete}" />
                    </UniformGrid>
                </Border>
            </Grid>
            </Grid>
        </Grid>

        <!--  Állapotsor  -->
        <Border
            Grid.Row="4"
            Padding="18,6,18,10"
            Visibility="{Binding DualPaneEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SelectedTab.StatusText}" />
        </Border>

        <!--
            Aktivitás-központ: saját másolás/áthelyezés/törlés folyamatjelzője
            — NEM a Windows beépített másoló-párbeszédablaka. Lebeg a tartalom
            fölött, jobbra lent, mint a Chrome letöltés-panelje — összecsukható,
            több egyidejű művelet egymás alatt. Lásd FileOperationEngine.
        -->
        <!--  Visszajelző buborék (másolás, kivágás, beillesztés…) — lásd MainWindow.ShowToast.  -->
        <Border
            x:Name="Toast"
            Grid.Row="3"
            Margin="0,0,0,26"
            Padding="16,9,18,9"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{DynamicResource TokenBgFlyout}"
            BorderBrush="{DynamicResource TokenBorderStrong}"
            BorderThickness="1"
            CornerRadius="20"
            IsHitTestVisible="False"
            Panel.ZIndex="20"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.4" ShadowDepth="3" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="ToastIcon"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource SystemAccentBrush}"
                    Symbol="Copy24" />
                <TextBlock
                    x:Name="ToastText"
                    MaxWidth="460"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!--
            TÖMÖR háttér (nem a félig átlátszó kártyaszín): a panel a
            fájllista fölött lebeg, és az áttetsző kártyaháttérrel szinte
            láthatatlan volt (felhasználói hibajelentés).
        -->
        <Border
            x:Name="ActivityPanel"
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource TokenBgFlyout}"
            BorderBrush="{DynamicResource TokenBorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding FileOperationJobs.Count, Converter={StaticResource CountToVisibility}}">
            <!--
                SZÁNDÉKOSAN nem a megosztott GlassPanelBrush (liquid glass
                kapcsoló) — ez a panel a folyamatosan változó fájllista FÖLÉ
                lebeg, ahol az áttetsző háttér a mozgó tartalom miatt
                olvashatatlanná/zavaróvá vált (felhasználói visszajelzés).
                Mindig tömör kártyaháttere van, függetlenül a Beállítások
                → Színtémák „folyékony üveg" kapcsolójától.
            -->
            <!--
                A fájlterületen BELÜL, a jobb alsó sarokban — korábban az ablak
                aljához igazodott, és egypaneles nézetben félig lelógott a
                fájlterületről az ablakkeretre. Kétpaneles nézetben a közös
                állapotsor fölé kerül.
            -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,0,26,20" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DualPaneEnabled}" Value="True">
                            <Setter Property="Margin" Value="0,0,26,50" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.55" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel Width="360">
                <ToggleButton
                    x:Name="ActivityHeaderToggle"
                    Padding="14,10"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    IsChecked="True">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold">
                            <InlineUIContainer BaselineAlignment="Center">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="16"
                                    Foreground="{DynamicResource SystemAccentBrush}"
                                    Symbol="ArrowSyncCircle24" />
                            </InlineUIContainer>
                            <Run Text="{loc:Loc FileOps_ActivityCenter}" />
                            <Run Text="(" /><Run Text="{Binding FileOperationJobs.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="ChevronDown24" />
                    </Grid>
                </ToggleButton>

                <ItemsControl
                    x:Name="ActivityJobsList"
                    MaxHeight="420"
                    Margin="0,0,0,8"
                    ItemsSource="{Binding FileOperationJobs}"
                    Visibility="{Binding IsChecked, ElementName=ActivityHeaderToggle, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type fileOps:FileOperationJob}">
                            <Border
                                Margin="10,0,10,10"
                                Padding="12"
                                Background="{DynamicResource TokenBgFlyoutCard}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding CurrentFileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ProgressText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Appearance="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding PauseCommand}"
                                                ToolTip="Szünet"
                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                                <ui:SymbolIcon FontSize="13" Symbol="Pause24" />
                                            </ui:Button>
                                            <ui:Button
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Appearance="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding ResumeCommand}"
                                                ToolTip="Folytatás"
                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon FontSize="13" Symbol="Play24" />
                                            </ui:Button>
                                            <ui:Button
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Appearance="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding CancelCommand}"
                                                ToolTip="Megszakítás"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon FontSize="13" Symbol="Dismiss24" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar
                                        Height="4"
                                        Margin="0,8,0,0"
                                        Maximum="1"
                                        Value="{Binding ProgressFraction, Mode=OneWay}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="{Binding SpeedText, Mode=OneWay}" />
                                        <Run Text="{Binding EtaText, Mode=OneWay, StringFormat=' · {0}'}" />
                                    </TextBlock>

                                    <!--  Névütközés — Felülírás / Kihagyás / Mindkettő megtartása / Alkalmazás az összesre  -->
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding PendingConflict, Converter={StaticResource NullToCollapsed}}">
                                        <StackPanel DataContext="{Binding PendingConflict}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{loc:Loc FileOps_ConflictTitle}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap">
                                                <Run Text="{loc:Loc FileOps_ConflictDestination}" />
                                                <Run Text=":" />
                                                <Run Text="{Binding DestinationSizeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <CheckBox
                                                Margin="0,6,0,0"
                                                Content="{loc:Loc FileOps_ApplyToAll}"
                                                IsChecked="{Binding ApplyToAll, Mode=TwoWay}" />
                                            <UniformGrid Margin="0,8,0,0" Columns="3">
                                                <ui:Button
                                                    Margin="0,0,4,0"
                                                    Command="{Binding ResolveCommand}"
                                                    CommandParameter="{x:Static fileOps:FileConflictAction.Overwrite}"
                                                    Content="{loc:Loc FileOps_Overwrite}"
                                                    FontSize="11" />
                                                <ui:Button
                                                    Margin="4,0,4,0"
                                                    Command="{Binding ResolveCommand}"
                                                    CommandParameter="{x:Static fileOps:FileConflictAction.Skip}"
                                                    Content="{loc:Loc FileOps_Skip}"
                                                    FontSize="11" />
                                                <ui:Button
                                                    Margin="4,0,0,0"
                                                    Command="{Binding ResolveCommand}"
                                                    CommandParameter="{x:Static fileOps:FileConflictAction.KeepBoth}"
                                                    Content="{loc:Loc FileOps_KeepBoth}"
                                                    FontSize="11" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TokenDanger}"
                                        Text="{Binding ErrorSummary}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding ErrorSummary, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
