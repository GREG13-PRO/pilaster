<ui:FluentWindow
    x:Class="Pilaster.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:fs="clr-namespace:Pilaster.Core.FileSystem;assembly=Pilaster.Core"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="Pilaster"
    Width="1280"
    Height="820"
    MinWidth="720"
    MinHeight="480"
    d1p1:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>

        <!--
            Animációs időzítések. A belépés gyorsabb, mint a kilépés: a
            rámutatásra azonnali választ várunk, az elhagyás viszont lágyabban
            olvad ki, különben a lista villogónak hat gyors egérmozgásnál.
        -->
        <Duration x:Key="HoverInDuration">0:0:0.10</Duration>
        <Duration x:Key="HoverOutDuration">0:0:0.18</Duration>

        <!--  Kiemelés átúsztatással — a sorok, csempék és oldalsáv-elemek közös mintája  -->
        <Storyboard x:Key="FadeInHighlight">
            <DoubleAnimation
                Storyboard.TargetName="Hover"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="{StaticResource HoverInDuration}" />
        </Storyboard>
        <Storyboard x:Key="FadeOutHighlight">
            <DoubleAnimation
                Storyboard.TargetName="Hover"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="{StaticResource HoverOutDuration}" />
        </Storyboard>

        <!--  Oldalsáv sor  -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="7"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="7"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>

                            <!--
                                Az aktuálisan megnyitott mappa kiemelése. Útvonal
                                alapján, nem a ListBox kijelölés-állapotán keresztül —
                                lásd SidebarItemViewModel.IsActive. (A fülsáv is ezt a
                                stílust használja, de a TabViewModelnek nincs IsActive
                                tulajdonsága, ezért ott a trigger ártalmatlanul soha nem
                                talál kötést.)
                            -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Oszlopfejléc. A beépített GridView a klasszikus WPF-témát hozza
            magával (világos háttér, sötét szöveg), ami sötét módban idegen
            testként ülne a felületen — ezért saját sablont kap.
        -->
        <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0">
                            <StackPanel
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="Arrow"
                                    Margin="6,1,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>

                            <!--  A rendezés iránya nyíllal, ahogy az Explorerben  -->
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Ascending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25B2;" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Descending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Fájllista sor a részletes nézetben  -->
        <Style x:Key="FileRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Margin="4,1">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Csempe a rácsnézetben  -->
        <Style x:Key="FileTileStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="4">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border Padding="6,10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeInHighlight}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOutHighlight}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Címsor  -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Pilaster"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Pilaster;component/Assets/app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Fülsáv  -->
        <Border
            Grid.Row="1"
            Padding="10,0,10,4">
            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Padding" Value="12,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="15"
                                Symbol="Folder24" />
                            <TextBlock
                                MaxWidth="180"
                                VerticalAlignment="Center"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--  Eszköztár: navigáció, útvonalsáv, keresés, nézetváltó  -->
        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="0,0,8,0"
                Orientation="Horizontal">
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding SelectedTab.GoBackCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoBack}"
                    ToolTip="{loc:Loc Cmd_Back}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowLeft24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding SelectedTab.GoForwardCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoForward}"
                    ToolTip="{loc:Loc Cmd_Forward}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRight24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding SelectedTab.GoUpCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoUp}"
                    ToolTip="{loc:Loc Cmd_Up}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowUp24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding SelectedTab.RefreshCommand}"
                    ToolTip="{loc:Loc Cmd_Refresh}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>

                <Rectangle
                    Width="1"
                    Margin="6,7"
                    Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!--  Két testreszabható gyorsgomb — a viselkedésük a Beállításokban állítható  -->
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding RunQuickActionCommand}"
                    CommandParameter="1"
                    ToolTip="{Binding QuickAction1Label}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding QuickAction1Icon}" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding RunQuickActionCommand}"
                    CommandParameter="2"
                    ToolTip="{Binding QuickAction2Label}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding QuickAction2Icon}" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <!--  Útvonalsáv  -->
            <Border
                Grid.Column="1"
                Padding="6,3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedTab.Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button
                                        Padding="7,3"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.OpenBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Label}" />
                                    <ui:SymbolIcon
                                        Margin="1,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="ChevronRight24" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ui:TextBox
                Grid.Column="2"
                Width="240"
                Margin="8,0,8,0"
                PlaceholderText="{loc:Loc Search_Placeholder}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!--
                Kevésbé gyakran használt funkciók egy helyen. A nézetmód és a
                rejtett elemek kapcsolója korábban két külön, állandóan látható
                vezérlő volt (az utóbbi egy teljes szöveges felirattal) — ez
                zsúfolttá tette a sávot. Most egy tömör „több" gomb mögé
                kerültek, a gyakran használt navigáció/létrehozás/téma/
                beállítások gombok pedig változatlanul azonnal elérhetők.
            -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button
                    Click="OnOverflowMenuClick"
                    Appearance="Transparent"
                    ToolTip="{loc:Loc Cmd_More}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    </ui:Button.Icon>
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc View_Mode}">
                                <MenuItem Click="OnSetViewDetails" Header="{loc:Loc View_Details}" />
                                <MenuItem Click="OnSetViewGrid" Header="{loc:Loc View_Grid}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="{loc:Loc Cmd_ToggleHidden}"
                                IsCheckable="True"
                                IsChecked="{Binding SelectedTab.ShowHiddenItems, Mode=TwoWay}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>

                <!--  Téma-kapcsoló: az ikon azt mutatja, amire váltani fog  -->
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding ToggleThemeCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    ToolTip="{loc:Loc Cmd_ToggleTheme}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding ThemeIcon}" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="{loc:Loc Cmd_Settings}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!--  Tartalom: oldalsáv + fájllista  -->
        <Grid Grid.Row="3" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Oldalsáv  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <ScrollViewer Padding="0,6" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SidebarSection}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock
                                        Margin="16,6,12,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Header}" />
                                    <ListBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                        ItemsSource="{Binding Items}"
                                        SelectionChanged="OnSidebarSelectionChanged"
                                        SelectionMode="Single">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Symbol="{Binding Icon}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Label}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!--  Meghajtóknál kihasználtság-sáv  -->
                                                    <StackPanel
                                                        Margin="26,5,2,0"
                                                        Visibility="{Binding IsDrive, Converter={StaticResource BoolToVisibility}}">
                                                        <ProgressBar
                                                            Height="3"
                                                            Maximum="1"
                                                            Value="{Binding UsedFraction, Mode=OneWay}" />
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                Background="Transparent" />

            <!--  Fájlterület  -->
            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <Grid>

                    <!--  Részletes nézet  -->
                    <ListView
                        x:Name="DetailsView"
                        Background="Transparent"
                        BorderThickness="0"
                        GridViewColumnHeader.Click="OnColumnHeaderClick"
                        ItemContainerStyle="{StaticResource FileRowStyle}"
                        ItemsSource="{Binding SelectedTab.Items}"
                        MouseDoubleClick="OnItemDoubleClick"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Extended"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                                <GridViewColumn
                                    Width="380"
                                    controls:GridViewSort.SortKey="Name"
                                    Header="{loc:Loc Col_Name}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:ShellIconImage
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    IconSize="16"
                                                    Item="{Binding}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="150"
                                    controls:GridViewSort.SortKey="Modified"
                                    Header="{loc:Loc Col_Modified}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="130"
                                    controls:GridViewSort.SortKey="Type"
                                    Header="{loc:Loc Col_Type}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Converter={StaticResource FileType}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="100"
                                    controls:GridViewSort.SortKey="Size"
                                    Header="{loc:Loc Col_Size}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!--  Rácsnézet  -->
                    <ListBox
                        x:Name="GridViewList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource FileTileStyle}"
                        ItemsSource="{Binding SelectedTab.Items}"
                        MouseDoubleClick="OnItemDoubleClick"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Extended"
                        Visibility="Collapsed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingWrapPanel ItemWidth="116" ItemHeight="112" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type fs:FileSystemItem}">
                                <StackPanel Width="104">
                                    <controls:ShellIconImage
                                        Width="48"
                                        Height="48"
                                        Margin="0,4,0,8"
                                        HorizontalAlignment="Center"
                                        IconSize="48"
                                        Item="{Binding}" />
                                    <TextBlock
                                        MaxHeight="34"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Üres mappa / hiba üzenet  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding SelectedTab.EmptyMessage}"
                        Visibility="{Binding SelectedTab.EmptyMessage, Converter={StaticResource NullToCollapsed}}" />

                    <ui:ProgressRing
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Állapotsor  -->
        <Border
            Grid.Row="4"
            Padding="18,6,18,10">
            <TextBlock
