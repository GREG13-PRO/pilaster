<ui:FluentWindow
    x:Class="Pilaster.App.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="{loc:Loc Editor_Title}"
    Width="1000"
    Height="720"
    MinWidth="620"
    MinHeight="400"
    d:DataContext="{d:DesignInstance vm:EditorViewModel}"
    mc:Ignorable="d"
    Icon="pack://application:,,,/Pilaster;component/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Loc Editor_Title}" />

        <!--  Eszköztár  -->
        <StackPanel
            Grid.Row="1"
            Margin="12,0,12,6"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,4,0"
                Command="{Binding NewFileCommand}"
                ToolTip="{loc:Loc Editor_New}">
                <ui:SymbolIcon FontSize="14" Symbol="DocumentAdd24" />
            </ui:Button>
            <ui:Button
                Margin="0,0,4,0"
                Click="OnOpenClick"
                ToolTip="{loc:Loc Cmd_Open}">
                <ui:SymbolIcon FontSize="14" Symbol="FolderOpen24" />
            </ui:Button>
            <ui:Button
                Margin="0,0,4,0"
                Command="{Binding SaveCommand}"
                ToolTip="{loc:Loc Editor_Save}">
                <ui:SymbolIcon FontSize="14" Symbol="Save24" />
            </ui:Button>
            <ui:Button
                Margin="0,0,12,0"
                Command="{Binding SaveAsCommand}"
                ToolTip="{loc:Loc Editor_SaveAs}">
                <ui:SymbolIcon FontSize="14" Symbol="SaveEdit24" />
            </ui:Button>
            <ui:Button
                Margin="0,0,4,0"
                Click="OnFindClick"
                ToolTip="{loc:Loc Editor_Find}">
                <ui:SymbolIcon FontSize="14" Symbol="Search24" />
            </ui:Button>
            <ui:Button
                Margin="0,0,4,0"
                Click="OnGoToLineClick"
                ToolTip="{loc:Loc Editor_GoToLine}">
                <ui:SymbolIcon FontSize="14" Symbol="ArrowDown24" />
            </ui:Button>
        </StackPanel>

        <!--  Fülsáv: fájlonként egy fül, módosított jelöléssel  -->
        <ScrollViewer
            Grid.Row="2"
            Margin="12,0,12,6"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Documents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EditorDocumentViewModel}">
                        <Border Margin="0,0,4,0" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    Padding="10,4"
                                    Appearance="Transparent"
                                    Click="OnTabClick"
                                    FontSize="12"
                                    Tag="{Binding}"
                                    ToolTip="{Binding FilePath}">
                                    <TextBlock
                                        MaxWidth="180"
                                        Text="{Binding TabTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </ui:Button>
                                <ui:Button
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{loc:Loc Cmd_CloseTab}">
                                    <ui:SymbolIcon FontSize="10" Symbol="Dismiss24" />
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Bannerek: írásvédett fájl és külső változás  -->
        <StackPanel Grid.Row="3" Margin="12,0,12,6" DataContext="{Binding ActiveDocument}">
            <Border
                Padding="12,8"
                Background="{DynamicResource TokenBgSurface}"
                BorderBrush="{DynamicResource TokenWarning}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TokenWarning}"
                        Symbol="LockClosed24" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,6,0,0"
                Padding="12,8"
                Background="{DynamicResource TokenBgSurface}"
                BorderBrush="{DynamicResource TokenAccent}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasExternalChange, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{loc:Loc Editor_ExternalChange}"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Click="OnReloadClick"
                        Content="{loc:Loc Editor_Reload}" />
                </Grid>
            </Border>
        </StackPanel>

        <!--
            A szerkesztő. Az AvalonEdit adja a virtualizált renderelést (nagy
            fájlnál is akadásmentes), a korlátlan visszavonást, a
            szintaxiskiemelést és a Ctrl+F kereső panelt.
        -->
        <Border
            Grid.Row="4"
            Margin="12,0,12,6"
            Background="{DynamicResource TokenBgSurface}"
            BorderBrush="{DynamicResource TokenBorder}"
            BorderThickness="1"
            CornerRadius="8">
            <avalon:TextEditor
                x:Name="Editor"
                Margin="4"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource TokenTextPrimary}"
                ShowLineNumbers="{Binding ShowLineNumbers}"
                WordWrap="{Binding WordWrap}" />
        </Border>

        <!--  Betöltés-jelző nagy fájlhoz: arány + megszakítás (spec Q2)  -->
        <Border
            Grid.Row="4"
            Padding="18,14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource TokenBgElevated}"
            BorderBrush="{DynamicResource TokenBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Width="320">
                <TextBlock
                    Margin="0,0,0,8"
                    Text="{Binding LoadingFileName}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Height="6"
                    Maximum="1"
                    Value="{Binding LoadProgress, Mode=OneWay}" />
                <ui:Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelLoadCommand}"
                    Content="{loc:Loc Cmd_Cancel}" />
            </StackPanel>
        </Border>
        <!--  Státuszsor: sor:oszlop, kijelölés, kódolás, sorvég, nyelv, INS/OVR  -->
        <Border
            Grid.Row="5"
            Padding="14,6,14,10"
            Background="{DynamicResource TokenBgApp}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TokenTextSecondary}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{Binding CaretLabel}" />
                    <TextBlock
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{Binding SelectionLength, StringFormat={}{0} ch}"
                        Visibility="{Binding SelectionLength, Converter={StaticResource CountToVisibility}}" />

                    <!--  Kódolás: kattintva újranyitás vagy mentés ezzel a kódolással  -->
                    <ui:Button
                        Margin="0,0,6,0"
                        Padding="8,2"
                        Appearance="Transparent"
                        Click="OnEncodingClick"
                        Content="{Binding ActiveDocument.EncodingLabel}"
                        FontSize="12" />

                    <ui:Button
                        Margin="0,0,6,0"
                        Padding="8,2"
                        Appearance="Transparent"
                        Click="OnLineEndingClick"
                        Content="{Binding ActiveDocument.LineEnding}"
                        FontSize="12" />

                    <TextBlock
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{Binding ActiveDocument.LanguageLabel}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{Binding InsertModeLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
