<ui:FluentWindow
    x:Class="Pilaster.App.Views.QuickAccessEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="{loc:Loc QuickAccess_EditTitle}"
    Width="720"
    Height="620"
    MinWidth="560"
    MinHeight="440"
    d:DataContext="{d:DesignInstance vm:QuickAccessEditorViewModel}"
    mc:Ignorable="d"
    Icon="pack://application:,,,/Pilaster;component/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{loc:Loc QuickAccess_EditTitle}"
            ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="18,4,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                A lista húzással rendezhető: az egérlenyomás jegyzi a forrást,
                a leejtés a cél sor indexére mozgat — lásd a kódmögöttest.
            -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource TokenBgSurface}"
                BorderBrush="{DynamicResource TokenBorder}"
                BorderThickness="1"
                CornerRadius="8">
                <ListBox
                    x:Name="RowList"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Drop="OnRowDrop"
                    ItemsSource="{Binding Rows}"
                    PreviewMouseLeftButtonDown="OnRowPreviewMouseDown"
                    PreviewMouseMove="OnRowPreviewMouseMove"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="{DynamicResource TokenRowPadding}" />
                            <Setter Property="MinHeight" Value="{DynamicResource TokenRowHeight}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickAccessRowViewModel}">
                            <Grid Opacity="{Binding Visible, Converter={StaticResource HiddenOpacityInverse}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Elválasztó sor: vonal, felirat nélkül  -->
                                <Rectangle
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="0,8"
                                    Fill="{DynamicResource TokenBorderStrong}"
                                    Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            Symbol="{Binding Icon, Converter={StaticResource IconName}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding DisplayLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ui:SymbolIcon
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{DynamicResource TokenWarning}"
                                            Symbol="Warning24"
                                            ToolTip="{loc:Loc QuickAccess_Unreachable}"
                                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="26,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TokenTextMuted}"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!--  Lista alatti műveletsor  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,0,0"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,6,0"
                    Command="{Binding AddFolderCommand}"
                    Content="{loc:Loc QuickAccess_AddFolder}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Command="{Binding AddSeparatorCommand}"
                    Content="{loc:Loc QuickAccess_AddSeparator}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Command="{Binding MoveUpCommand}"
                    CommandParameter="{Binding SelectedRow}"
                    ToolTip="{loc:Loc QuickAccess_MoveUp}">
                    <ui:SymbolIcon FontSize="13" Symbol="ArrowUp24" />
                </ui:Button>
                <ui:Button
                    Margin="0,0,6,0"
                    Command="{Binding MoveDownCommand}"
                    CommandParameter="{Binding SelectedRow}"
                    ToolTip="{loc:Loc QuickAccess_MoveDown}">
                    <ui:SymbolIcon FontSize="13" Symbol="ArrowDown24" />
                </ui:Button>
                <ui:Button
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding SelectedRow}"
                    ToolTip="{loc:Loc Cmd_Delete}">
                    <ui:SymbolIcon FontSize="13" Symbol="Delete24" />
                </ui:Button>
            </StackPanel>

            <GridSplitter
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="10"
                HorizontalAlignment="Center"
                Background="Transparent" />

            <!--  A kijelölt sor tulajdonságai  -->
            <ScrollViewer
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedRow}" IsEnabled="{Binding Converter={StaticResource NotNull}}">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{loc:Loc QuickAccess_Label}" />
                    <ui:TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{loc:Loc QuickAccess_Path}" />
                    <ui:TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{loc:Loc QuickAccess_Group}" />
                    <ui:TextBox Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{loc:Loc QuickAccess_Icon}" />
                    <ComboBox
                        ItemsSource="{Binding DataContext.IconChoices, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                        SelectedItem="{Binding Icon, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type sys:String}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        FontSize="15"
                                        Symbol="{Binding Converter={StaticResource IconName}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{loc:Loc QuickAccess_Color}" />
                    <ItemsControl ItemsSource="{Binding DataContext.ColorChoices, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sys:String}">
                                <ui:Button
                                    Margin="0,0,6,6"
                                    Padding="4"
                                    Appearance="Transparent"
                                    Click="OnColorSwatchClick"
                                    Tag="{Binding}">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource TokenBorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="5" />
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button
                        Margin="0,0,0,4"
                        Click="OnClearColorClick"
                        Content="{loc:Loc QuickAccess_DefaultColor}" />

                    <CheckBox
                        Margin="0,12,0,0"
                        Content="{loc:Loc QuickAccess_Visible}"
                        IsChecked="{Binding Visible, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Alsó sáv: Legutóbbi beállításai + Import/Export + Mentés/Mégse  -->
        <Border
            Grid.Row="2"
            Margin="18,12,18,16"
            Padding="0">
            <StackPanel>
                <Border
                    Padding="14,10"
                    Background="{DynamicResource TokenBgSurface}"
                    BorderBrush="{DynamicResource TokenBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{loc:Loc QuickAccess_RecentEnabled}"
                            IsChecked="{Binding RecentEnabled, Mode=TwoWay}" />
                        <TextBlock
                            Margin="18,0,6,0"
                            VerticalAlignment="Center"
                            Text="{loc:Loc QuickAccess_RecentLimit}" />
                        <ui:NumberBox
                            Width="90"
                            VerticalAlignment="Center"
                            Maximum="40"
                            Minimum="1"
                            Value="{Binding RecentLimit, Mode=TwoWay}" />
                        <ui:Button
                            Margin="18,0,0,0"
                            Command="{Binding ClearRecentCommand}"
                            Content="{loc:Loc QuickAccess_ClearRecent}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="2,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TokenTextSecondary}"
                    Text="{Binding StatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

                <Grid Margin="0,12,0,0">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            Command="{Binding ImportCommand}"
                            Content="{loc:Loc QuickAccess_Import}" />
                        <ui:Button
                            Margin="0,0,6,0"
                            Command="{Binding ExportCommand}"
                            Content="{loc:Loc QuickAccess_Export}" />
                        <ui:Button
                            Command="{Binding ResetDefaultsCommand}"
                            Content="{loc:Loc QuickAccess_ResetDefaults}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            Command="{Binding CancelCommand}"
                            Content="{loc:Loc Cmd_Cancel}" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="{loc:Loc Cmd_Ok}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
