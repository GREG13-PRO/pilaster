<Window
    x:Class="Pilaster.App.Views.FileDialogCompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="Pilaster"
    Width="272"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <!--
        Fájlablak-panel: egy Megnyitás/Mentés ablak (pl. a böngésző feltöltő
        ablaka) mellé tapad, amíg az az előtérben van. Sosem aktiválódik
        (lásd FileDialogCompanionWindow.xaml.cs, WS_EX_NOACTIVATE), így a
        fájlablak marad fókuszban, a kattintás pedig odaugratja.
    -->
    <Border
        Margin="10"
        Background="{DynamicResource TokenBgFlyout}"
        BorderBrush="{DynamicResource TokenBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Opacity="0.35"
                ShadowDepth="3" />
        </Border.Effect>
        <DockPanel Margin="0,0,0,8">
            <StackPanel
                Margin="14,12,14,6"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <Image
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Source="pack://application:,,,/Pilaster;component/Assets/app-icon.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TokenTextPrimary}"
                        Text="Pilaster" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TokenTextMuted}"
                        Text="{loc:Loc FileDialogCompanion_Subtitle}" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Margin="14,4,14,0"
                DockPanel.Dock="Bottom"
                FontSize="11"
                Foreground="{DynamicResource TokenTextMuted}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ScrollViewer
                x:Name="Scroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileDialogCompanionSection}">
                            <StackPanel Margin="0,4,0,2">
                                <TextBlock
                                    Margin="16,6,14,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TokenTextMuted}"
                                    Text="{Binding Header}" />
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FileDialogCompanionEntry}">
                                            <Button
                                                Margin="6,0"
                                                AutomationProperties.Name="{Binding Label}"
                                                Click="OnEntryClick"
                                                Cursor="Hand"
                                                Focusable="False"
                                                Tag="{Binding Path}"
                                                ToolTip="{Binding Path}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="Row"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            CornerRadius="6">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TokenHover}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TokenSelected}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <DockPanel>
                                                    <controls:ShellIconImage
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,10,0"
                                                        DockPanel.Dock="Left"
                                                        IconSize="16"
                                                        Item="{Binding Item}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TokenTextPrimary}"
                                                        Text="{Binding Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
