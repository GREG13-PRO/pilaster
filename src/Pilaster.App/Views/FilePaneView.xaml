<UserControl
    x:Class="Pilaster.App.Views.FilePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="clr-namespace:Pilaster.Core.FileSystem;assembly=Pilaster.Core"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:PaneViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Duration x:Key="PaneHoverDuration">0:0:0.10</Duration>

        <Storyboard x:Key="PaneFadeIn">
            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource PaneHoverDuration}" />
        </Storyboard>
        <Storyboard x:Key="PaneFadeOut">
            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource PaneHoverDuration}" />
        </Storyboard>

        <!--
            Oszlopfejléc — másolat a MainWindow.xaml ColumnHeaderStyle-jából:
            egy UserControl saját XAML-je nem lát StaticResource-t a szülő
            ablak erőforrásaiból, csak a sajátjaiból (spec K1, v1.0.1).
        -->
        <Style x:Key="PaneColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource TokenBorder}"
                            BorderThickness="0,0,0,1">
                            <StackPanel
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="Arrow"
                                    Margin="5,1,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="8"
                                    Foreground="{DynamicResource TokenAccent}"
                                    Text="" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TokenHover}" />
                            </Trigger>
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Ascending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25B2;" />
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}" />
                            </Trigger>
                            <Trigger Property="controls:GridViewSort.Indicator" Value="Descending">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Sor-stílus a kétpaneles nézethez — szándékosan NEM a MainWindow.xaml
            FileRowStyle-ja (az a fő ablak lokális erőforrásaiban él, egy
            UserControl saját XAML-je onnan nem lát StaticResource-t).
            GridViewRowPresenter-t használ (spec K1, v1.0.1), hogy az
            oszlopok mindkét irányban (fejléc/sor) ugyanazt a szélesség-
            gyűjteményt kövessék.
        -->
        <Style x:Key="PaneRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="{DynamicResource TokenRowPadding}" />
            <Setter Property="Height" Value="{DynamicResource TokenRowHeight}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <Setter Property="ContextMenu" Value="{StaticResource PaneItemContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Margin="{DynamicResource TokenRowMargin}" Background="Transparent">
                            <!--
                                Páros/páratlan csíkozás (spec K3, v1.0.1) — a
                                Hover/Selected réteg ALATT ül, hogy azok
                                mindig felülírják.
                            -->
                            <Border
                                x:Name="Stripe"
                                Margin="4,0"
                                Background="{DynamicResource TokenBgApp}"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border
                                x:Name="Hover"
                                Margin="4,0"
                                Background="{DynamicResource TokenHover}"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Margin="4,0"
                                Background="{DynamicResource AccentSelectionBrush}"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PaneFadeIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PaneFadeOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>

                            <!--
                                Inaktív kijelölés: ha a panel elveszti a fókuszt, a
                                kijelölés halványabb lesz, de LÁTHATÓ marad — enélkül
                                a másik panelbe kattintva úgy tűnne, mintha a kijelölés
                                megszűnt volna (spec F7 tesztlista).
                            -->
                            <!--
                                MultiDataTrigger, nem MultiTrigger: egy MultiTrigger
                                CSAK Property-feltételeket fogad, a kettő keverése
                                futásidőben "Property can not be null on Trigger"
                                kivétellel jár. Az IsSelected ezért itt is kötésként,
                                a TemplatedParent-en keresztül olvasódik.
                            -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Selected" Property="Background" Value="{DynamicResource TokenSelectedInactive}" />
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ItemsControl.AlternationIndex)}" Value="1" />
                                    <Condition Binding="{Binding DataContext.RowStriping, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Stripe" Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PaneNameEditTemplate" DataType="{x:Type fs:FileSystemItem}">
            <ui:TextBox
                x:Name="RenameBox"
                MinWidth="60"
                Padding="2,0"
                VerticalAlignment="Center"
                IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                KeyDown="OnRenameBoxKeyDown"
                LostFocus="OnRenameBoxLostFocus"
                Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{Binding RenameError}" />
        </DataTemplate>

        <DataTemplate x:Key="PaneNameDisplayTemplate" DataType="{x:Type fs:FileSystemItem}">
            <StackPanel Orientation="Horizontal">
                <Grid
                    Width="18"
                    Height="18"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                    <controls:ShellIconImage
                        IconSize="16"
                        Item="{Binding}"
                        Visibility="{Binding IsRecycled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <!--  Lomtár-elem: lásd MainWindow.xaml azonos megjegyzése a Név oszlopnál.  -->
                    <ui:SymbolIcon
                        FontSize="16"
                        Symbol="Document24"
                        Visibility="{Binding IsRecycled, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Directory">
                                        <Setter Property="Symbol" Value="Folder24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />

                <!--  Címke-színminták — ugyanaz a vezérlő, mint a fő fájllistán (lásd Controls/TagSwatch.cs).  -->
                <ItemsControl Margin="6,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TagSwatch
                                Width="9"
                                Height="9"
                                Margin="1,0"
                                ColorHex="{Binding ColorHex}"
                                TagColor="{Binding Color}"
                                ToolTip="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:SymbolIcon
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Filled="True"
                    Foreground="{DynamicResource TokenDanger}"
                    Symbol="Heart24"
                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaneNameCellTemplate" DataType="{x:Type fs:FileSystemItem}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PaneNameDisplayTemplate}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource PaneNameEditTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="PaneSizeCellTemplate" DataType="{x:Type fs:FileSystemItem}">
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource TokenTextSecondary}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource FolderAwareSize}">
                        <Binding Path="Kind" />
                        <Binding Path="SizeBytes" />
                        <Binding Path="ComputedFolderSize" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="PaneTypeCellTemplate" DataType="{x:Type fs:FileSystemItem}">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource TokenTextSecondary}"
                Text="{Binding Converter={StaticResource FileType}}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="PaneModifiedCellTemplate" DataType="{x:Type fs:FileSystemItem}">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource TokenTextSecondary}"
                Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
        </DataTemplate>

        <!--
            A panel jobbklikk-menüje. Az F4-es teljes, shell-bővítményeket is
            megjelenítő saját menü a PilasterContextMenu-n keresztül nyílik meg
            (lásd OnItemPreviewRightButtonDown); ez itt csak akkor lép be, ha
            az valamiért nem elérhető.
        -->
        <ContextMenu x:Key="PaneItemContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Click="OnOpenItemClick" Header="{loc:Loc Cmd_Open}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnCopyItemClick" Header="{loc:Loc Cmd_Copy}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DocumentCopy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnCutItemClick" Header="{loc:Loc Cmd_Cut}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Cut24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnDeleteItemClick" Header="{loc:Loc Cmd_Delete}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnShowPropertiesClick" Header="{loc:Loc Cmd_Properties}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="PaneEmptyContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Click="OnPasteClick" Header="{loc:Loc Cmd_Paste}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ClipboardPaste24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <!--
        Az aktív panel jelzése (spec K5, v1.0.1): korábban egy 1,5 px-es,
        MIND A NÉGY oldalon akcentusszínű keret volt — ez erősebb hatást
        keltett, mint maga a tartalom. Most a keret mindig semleges, csak a
        FELSŐ éle vastagodik és színeződik akcentusra, amíg a panel aktív —
        finomabb, de egyértelmű jelzés.
    -->
    <Border
        x:Name="RootBorder"
        Background="{DynamicResource TokenBgSurface}"
        CornerRadius="10"
        PreviewMouseDown="OnRootPreviewMouseDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
                        <Setter Property="BorderThickness" Value="1,3,1,1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Panelenkénti saját fülsáv (Ctrl+T / Ctrl+W / Ctrl+Tab)  -->
            <Grid Grid.Row="0" Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    Grid.Column="0"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Border
                                    Margin="0,0,3,0"
                                    Padding="0"
                                    CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActiveInPane}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            Padding="8,3"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            FontSize="12"
                                            ToolTip="{Binding CurrentPath}">
                                            <TextBlock
                                                MaxWidth="120"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                        </ui:Button>
                                        <ui:Button
                                            Padding="3"
                                            VerticalAlignment="Center"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc Cmd_CloseTab}">
                                            <ui:SymbolIcon FontSize="10" Symbol="Dismiss24" />
                                        </ui:Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ui:Button
                    Grid.Column="1"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Appearance="Transparent"
                    Command="{Binding NewTabCommand}"
                    ToolTip="{loc:Loc Cmd_NewTab}">
                    <ui:SymbolIcon FontSize="13" Symbol="Add24" />
                </ui:Button>
            </Grid>

            <!--
                Eszköztár + útvonalsáv EGYBEN (spec K4, v1.0.1): korábban két
                külön sor volt — vissza/előre/fel/frissítés a breadcrumb
                fölött —, ami két sornyi helyet vett el a fájllistától.
            -->
            <Grid
                Grid.Row="1"
                Margin="2,0,2,4"
                DataContext="{Binding ActiveTab}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        ToolTip="{loc:Loc Cmd_Back}">
                        <ui:SymbolIcon FontSize="14" Symbol="ArrowLeft24" />
                    </ui:Button>
                    <ui:Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        ToolTip="{loc:Loc Cmd_Forward}">
                        <ui:SymbolIcon FontSize="14" Symbol="ArrowRight24" />
                    </ui:Button>
                    <ui:Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        Command="{Binding GoUpCommand}"
                        IsEnabled="{Binding CanGoUp}"
                        ToolTip="{loc:Loc Cmd_Up}">
                        <ui:SymbolIcon FontSize="14" Symbol="ArrowUp24" />
                    </ui:Button>
                    <ui:Button
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        Padding="0"
                        Appearance="Transparent"
                        Command="{Binding RefreshCommand}"
                        ToolTip="{loc:Loc Cmd_Refresh}">
                        <ui:SymbolIcon FontSize="14" Symbol="ArrowClockwise24" />
                    </ui:Button>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="7,4"
                    Background="{DynamicResource TokenBgInput}"
                    BorderBrush="{DynamicResource TokenBorder}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            Padding="4,0"
                                            Appearance="Transparent"
                                            Click="OnBreadcrumbClick"
                                            Content="{Binding Label}"
                                            FontSize="12"
                                            Tag="{Binding Path}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource TokenTextMuted}"
                                            Text="›" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" DataContext="{Binding ActiveTab}">
                <ListView
                    x:Name="List"
                    AllowDrop="True"
                    AlternationCount="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ContextMenu="{StaticResource PaneEmptyContextMenu}"
                    DragOver="OnListDragOver"
                    Drop="OnListDrop"
                    GridViewColumnHeader.Click="OnPaneColumnHeaderClick"
                    ItemContainerStyle="{StaticResource PaneRowStyle}"
                    ItemsSource="{Binding Items}"
                    MouseDoubleClick="OnItemDoubleClick"
                    PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                    PreviewMouseMove="OnItemPreviewMouseMove"
                    PreviewMouseRightButtonDown="OnItemPreviewRightButtonDown"
                    SelectionChanged="OnListSelectionChanged"
                    SelectionMode="Extended"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <!--
                        Oszlopfejlécek (spec K1/K2, v1.0.1): Név/Méret/Típus/
                        Módosítva, kattintással rendezhető, húzással
                        átméretezhető. A Méret/Típus/Módosítva szélessége a
                        PaneViewModel-en él és panelenként külön mentődik
                        (AppSettings.LeftPane…/RightPane…) — az
                        ElementName-kötés azért kell, mert a GridViewColumn
                        nem a vizuális fa része, tehát a DataContext-öröklés
                        rajta nem működik. A Név oszlop a maradék helyet
                        tölti ki — ezt a GridViewColumn nem tudja "*"
                        méretezéssel, ezért a code-behind (OnListSizeChanged/
                        RecalculateNameColumnWidth) állítja be futásidőben.
                    -->
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource PaneColumnHeaderStyle}">
                            <GridViewColumn
                                x:Name="NameColumn"
                                CellTemplate="{StaticResource PaneNameCellTemplate}"
                                controls:GridViewSort.SortKey="Name"
                                Header="{loc:Loc Col_Name}" />
                            <GridViewColumn
                                x:Name="SizeColumn"
                                Width="{Binding ElementName=RootBorder, Path=DataContext.SizeColumnWidth, Mode=TwoWay}"
                                CellTemplate="{StaticResource PaneSizeCellTemplate}"
                                controls:GridViewSort.SortKey="Size"
                                Header="{loc:Loc Col_Size}" />
                            <GridViewColumn
                                x:Name="TypeColumn"
                                Width="{Binding ElementName=RootBorder, Path=DataContext.TypeColumnWidth, Mode=TwoWay}"
                                CellTemplate="{StaticResource PaneTypeCellTemplate}"
                                controls:GridViewSort.SortKey="Type"
                                Header="{loc:Loc Col_Type}" />
                            <GridViewColumn
                                x:Name="ModifiedColumn"
                                Width="{Binding ElementName=RootBorder, Path=DataContext.ModifiedColumnWidth, Mode=TwoWay}"
                                CellTemplate="{StaticResource PaneModifiedCellTemplate}"
                                controls:GridViewSort.SortKey="Modified"
                                Header="{loc:Loc Col_Modified}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TokenTextMuted}"
                    Text="{Binding EmptyMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}" />

                <ui:ProgressRing
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!--
                    E1 (v1.0.1) tartalék: a kétpaneles nézetnek nincs
                    Kezdőlap-irányítópultja (az a v1.1 feladata), és az ÚJ
                    fülek emiatt mostantól valódi mappát nyitnak (lásd
                    PaneViewModel.SuppressHomeTab). Ha egy fül MÉGIS
                    Kezdőlap-állapotba kerülne (pl. egy régebbi mentett
                    munkamenetből), itt legalább a gyorselérés-lista
                    látszik — nem üres felület.
                -->
                <ScrollViewer
                    Padding="4"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding DataContext.Sections[0].Items, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                                <ui:Button
                                    Margin="0,0,0,2"
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Transparent"
                                    Click="OnHomeFallbackItemClick"
                                    Tag="{Binding Path}"
                                    Visibility="{Binding IsDashboardTile, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" FontSize="15" Symbol="{Binding Icon}" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
