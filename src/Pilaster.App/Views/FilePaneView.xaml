<UserControl
    x:Class="Pilaster.App.Views.FilePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="clr-namespace:Pilaster.Core.FileSystem;assembly=Pilaster.Core"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:TabViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Duration x:Key="PaneHoverDuration">0:0:0.10</Duration>

        <Storyboard x:Key="PaneFadeIn">
            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource PaneHoverDuration}" />
        </Storyboard>
        <Storyboard x:Key="PaneFadeOut">
            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource PaneHoverDuration}" />
        </Storyboard>

        <!--
            Könnyített sor-stílus a kétablakos nézethez — szándékosan NEM a
            MainWindow.xaml FileRowStyle-ja (az a fő ablak lokális
            erőforrásaiban él, egy UserControl saját XAML-je onnan nem lát
            StaticResource-t). Vizuálisan ugyanaz a mintázat (Hover/Selected
            réteg, kerekített sarok), csak itt, önállóan definiálva.
        -->
        <Style x:Key="PaneRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
            <Setter Property="ContextMenu" Value="{StaticResource PaneItemContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Margin="3,1" Background="Transparent">
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border
                                x:Name="Selected"
                                Background="{DynamicResource AccentSelectionBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PaneFadeIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PaneFadeOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PaneNameEditTemplate" DataType="{x:Type fs:FileSystemItem}">
            <ui:TextBox
                x:Name="RenameBox"
                MinWidth="60"
                Padding="2,0"
                VerticalAlignment="Center"
                IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                KeyDown="OnRenameBoxKeyDown"
                LostFocus="OnRenameBoxLostFocus"
                Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{Binding RenameError}" />
        </DataTemplate>

        <DataTemplate x:Key="PaneNameDisplayTemplate" DataType="{x:Type fs:FileSystemItem}">
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="18"
                    Height="18"
                    Margin="0,0,6,0"
                    Source="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Fill="#E81123"
                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaneItemTemplate" DataType="{x:Type fs:FileSystemItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    Grid.Column="0"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource PaneNameDisplayTemplate}"
                    Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PaneNameEditTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FolderAwareSize}">
                            <Binding Path="Kind" />
                            <Binding Path="SizeBytes" />
                            <Binding Path="ComputedFolderSize" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
            </Grid>
        </DataTemplate>

        <!--  Egyszerűsített jobbklikk-menü — a teljes natív Intéző-menü csak a fő fájllistán érhető el.  -->
        <ContextMenu x:Key="PaneItemContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Click="OnOpenItemClick" Header="{loc:Loc Cmd_Open}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnCopyItemClick" Header="{loc:Loc Cmd_Copy}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DocumentCopy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnCutItemClick" Header="{loc:Loc Cmd_Cut}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Cut24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnDeleteItemClick" Header="{loc:Loc Cmd_Delete}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnShowPropertiesClick" Header="{loc:Loc Cmd_Properties}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="PaneEmptyContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Click="OnPasteClick" Header="{loc:Loc Cmd_Paste}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ClipboardPaste24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Border
        x:Name="RootBorder"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderThickness="1.5"
        CornerRadius="8"
        PreviewMouseDown="OnRootPreviewMouseDown">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Mini eszköztár: vissza/előre/fel/frissítés  -->
            <StackPanel Grid.Row="0" Margin="2,0,2,4" Orientation="Horizontal">
                <ui:Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Appearance="Transparent"
                    Command="{Binding GoBackCommand}">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowLeft24" />
                </ui:Button>
                <ui:Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Appearance="Transparent"
                    Command="{Binding GoForwardCommand}">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowRight24" />
                </ui:Button>
                <ui:Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Appearance="Transparent"
                    Command="{Binding GoUpCommand}">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowUp24" />
                </ui:Button>
                <ui:Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Appearance="Transparent"
                    Command="{Binding RefreshCommand}">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowClockwise24" />
                </ui:Button>
            </StackPanel>

            <!--  Útvonalsáv  -->
            <Border
                Grid.Row="1"
                Margin="2,0,2,4"
                Padding="8,4"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button
                                        Padding="4,0"
                                        Appearance="Transparent"
                                        Click="OnBreadcrumbClick"
                                        Content="{Binding Label}"
                                        FontSize="12"
                                        Tag="{Binding Path}" />
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="›" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ListView
                x:Name="List"
                Grid.Row="2"
                AllowDrop="True"
                Background="Transparent"
                BorderThickness="0"
                ContextMenu="{StaticResource PaneEmptyContextMenu}"
                DragOver="OnListDragOver"
                Drop="OnListDrop"
                ItemContainerStyle="{StaticResource PaneRowStyle}"
                ItemTemplate="{StaticResource PaneItemTemplate}"
                ItemsSource="{Binding Items}"
                MouseDoubleClick="OnItemDoubleClick"
                PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                PreviewMouseMove="OnItemPreviewMouseMove"
                PreviewMouseRightButtonDown="OnItemPreviewRightButtonDown"
                SelectionMode="Extended"
                View="{x:Null}">
                <ListView.Resources>
                    <Style TargetType="{x:Type ScrollBar}" />
                </ListView.Resources>
            </ListView>

            <TextBlock
                Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding EmptyMessage}"
                Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
    </Border>
</UserControl>
