                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="advanced.logFile">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_OpenLog}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_OpenLogHint}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnOpenLogClick"
                                Content="{loc:Loc Cmd_Open}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="advanced.configFolder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_OpenConfig}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_OpenConfigHint}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnOpenConfigFolderClick"
                                Content="{loc:Loc Cmd_Open}" />
                        </Grid>
                    </Border>
                
                <!--  ===== Gyorsgombok =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_QuickActions}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_QuickActionsHint}" />

                <ItemsControl ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickActionEditorViewModel}">
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>

                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Header, Converter={StaticResource LocalizeKey}}" />

                                    <!--
                                        Típus. A GroupName a szerkesztő fejlécéből jön, hogy a két
                                        gyorsgomb rádiói biztosan külön csoportba essenek — enélkül
                                        a második szerkesztő választása kikapcsolná az elsőét.
                                    -->
                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <RadioButton
                                            Margin="0,0,18,0"
                                            Content="{loc:Loc Type_Folder}"
                                            GroupName="{Binding Header}"
                                            IsChecked="{Binding Kind, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Folder}" />
                                        <RadioButton
                                            Content="{loc:Loc Type_File}"
                                            GroupName="{Binding Header}"
                                            IsChecked="{Binding Kind, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=File}" />
                                    </StackPanel>

                                    <!--  Kiterjesztés — csak fájlnál  -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc Settings_Extension}" />
                                        <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Extension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  Névsablon + élő előnézet  -->
                                    <TextBlock Margin="0,0,0,4" Text="{loc:Loc Settings_NameTemplate}" />
                                    <ui:TextBox Text="{Binding NameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_TemplateHint}" />

                                    <Border
                                        Margin="0,8,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc Settings_Preview}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Preview}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Cél  -->
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="{loc:Loc Settings_UseFixedPath}"
                                        IsChecked="{Binding UseFixedPath, Mode=TwoWay}" />

                                    <Grid Visibility="{Binding UseFixedPath, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Text="{Binding FixedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Command="{Binding BrowseFolderCommand}"
                                            Content="{loc:Loc Settings_Browse}" />
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="2,10,0,0"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_AutoSaved}" />
                </StackPanel>

                <!--  ===== about =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:about">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_About}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="about"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>

                <!--  ===== Frissítések =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Updates}" />

                <Border Style="{StaticResource CardStyle}" DataContext="{Binding Updates}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Settings_CurrentVersion}" />
                                    <!--
                                        Nincs szándékos vizuális jelzés (kurzor,
                                        aláhúzás) — lásd a Hibabejelentés fejlécének
                                        10-kattintásos gesztusát fentebb, ugyanaz a
                                        minta: SettingsViewModel.RegisterVersionClick,
                                        7 kattintásra rejtett üzenet bukkan fel.
                                    -->
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontWeight="SemiBold"
                                        MouseLeftButtonDown="OnVersionClick"
                                        Text="{Binding CurrentVersion, StringFormat=v{0}}" />
                                </StackPanel>
                                <TextBlock x:Name="UpdatesHintText" Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_UpdatesHint}" />
                            </StackPanel>
                            <Grid x:Name="UpdateCheckPanel" Grid.Column="1" VerticalAlignment="Center">
                                <ui:ProgressRing
                                    Width="18"
                                    Height="18"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Command="{Binding CheckNowCommand}"
                                    Content="{loc:Loc Update_CheckNow}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Grid>
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource CaptionStyle}"
                            Text="{Binding StatusMessage}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border x:Name="AutoUpdateCheckCard" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_CheckForUpdates}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_CheckForUpdatesHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" />
                    </Grid>
                </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

            <!--
                Alsó sáv: teljes export/import (spec F6). A kategória
                visszaállítása az egyoldalas elrendezésben az egyes
                kategóriák saját fejlécébe került — itt nem lenne egyértelmű,
                melyik kategóriára vonatkozik.
            -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="18,10,18,14">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            Command="{Binding ImportSettingsCommand}"
                            Content="{loc:Loc QuickAccess_Import}" />
                        <ui:Button
                            Command="{Binding ExportSettingsCommand}"
                            Content="{loc:Loc QuickAccess_Export}" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TokenTextSecondary}"
                        Text="{Binding StatusMessage}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                </Grid>
            </Border>
        </Grid>
        </Border>

        <!--
            Rejtett üzenet-toast: a verziószámra 7-szer kattintva (lásd
            OnVersionClick / SettingsViewModel.RegisterVersionClick) bukkan
            fel, magától eltűnik — semmilyen tartós állapotot nem módosít.
        -->
        <Border
            Margin="0,0,0,24"
            Padding="16,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="10"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.35" ShadowDepth="0" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEasterEgg}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{DynamicResource SystemAccentBrush}"
                    Symbol="Sparkle24" />
                <TextBlock
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    Text="{Binding EasterEggMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
