<ui:FluentWindow
    x:Class="Pilaster.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    xmlns:metadata="clr-namespace:Pilaster.Core.Metadata;assembly=Pilaster.Core"
    xmlns:settings="clr-namespace:Pilaster.Core.Settings;assembly=Pilaster.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="{loc:Loc Cmd_Settings}"
    Width="640"
    Height="760"
    MinWidth="520"
    MinHeight="480"
    Icon="pack://application:,,,/Pilaster;component/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>

        <!--  Egy beállítás-kártya: cím, leírás, jobb oldalt a vezérlő  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{loc:Loc Cmd_Settings}"
            ShowMaximize="False" />

        <Grid Grid.Row="1">
        <Border Background="{DynamicResource GlassPanelBrush}">
        <ScrollViewer
            x:Name="ContentScroll"
            Padding="22,4,22,22"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ===== Megjelenés =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Appearance}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Theme}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ThemeHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:ThemeMode}">
                                    <TextBlock Text="{Binding Converter={StaticResource ThemeMode}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Accent}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_AccentHint}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc Settings_AccentUseSystem}" />
                                <ui:ToggleSwitch IsChecked="{Binding UseSystemAccent, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!--
                            A paletta és a hex mező letiltva, amíg a rendszerszínt
                            követjük — enélkül úgy tűnne, mintha egyedi szín is
                            hatna, holott a kapcsoló felülírná a következő
                            rendszertéma-váltáskor.
                        -->
                        <ItemsControl
                            Margin="0,14,0,0"
                            IsEnabled="{Binding UseSystemAccent, Converter={StaticResource InvertBool}}"
                            ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type media:Color}">
                                    <ui:Button
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,8,8"
                                        Padding="0"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.SelectAccentPresetCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="16">
                                        <Ellipse
                                            Width="24"
                                            Height="24"
                                            Fill="{Binding Converter={StaticResource ColorToBrush}}" />
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0" IsEnabled="{Binding UseSystemAccent, Converter={StaticResource InvertBool}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                Margin="0,0,10,0"
                                Fill="{Binding CurrentAccentColor, Converter={StaticResource ColorToBrush}}" />
                            <ui:TextBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{Binding AccentHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding ApplyAccentHexCommand}"
                                Content="{loc:Loc Cmd_Apply}" />
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource TokenDanger}"
                            Text="{Binding AccentHexError}"
                            Visibility="{Binding AccentHexError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Animations}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_AnimationsHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding AnimationLevels}"
                            SelectedItem="{Binding SelectedAnimationLevel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:AnimationLevel}">
                                    <TextBlock Text="{Binding Converter={StaticResource AnimationLevel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_LiquidGlass}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_LiquidGlassHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding LiquidGlassEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  ===== Rendszerintegráció =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_ShellIntegration}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_ShellIntegrationHint}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc ShellIntegration_FolderOpen}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc ShellIntegration_FolderOpenHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="FolderOpenToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding FolderOpenRedirectEnabled, Mode=OneWay}"
                            PreviewMouseLeftButtonDown="OnFolderOpenRedirectPreviewClick" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc ShellIntegration_WinE}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc ShellIntegration_WinEHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding WinERedirectEnabled, Mode=OneWay}"
                            PreviewMouseLeftButtonDown="OnWinERedirectPreviewClick" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc ShellIntegration_ContextMenu}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc ShellIntegration_ContextMenuHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding ContextMenuEntryEnabled, Mode=OneWay}"
                            PreviewMouseLeftButtonDown="OnContextMenuEntryPreviewClick" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc ShellIntegration_ResetAll}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc ShellIntegration_ResetAllHint}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding ResetShellIntegrationCommand}"
                                Content="{loc:Loc Cmd_Reset}" />
                        </Grid>
                        <TextBlock
                            Margin="0,10,0,0"
                            Foreground="{DynamicResource TokenDanger}"
                            Text="{Binding ShellIntegrationError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ShellIntegrationError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!--  ===== Billentyűparancsok =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_TotalCommander}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_TotalCommander}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_TotalCommanderHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding TotalCommanderKeybindingsEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_ExternalEditor}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ExternalEditorHint}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding ExternalEditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseExternalEditorCommand}"
                                Content="{loc:Loc Cmd_Browse}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ===== Nyelv =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Language}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Language}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_LanguageHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  ===== Gyorsgombok =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_QuickActions}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_QuickActionsHint}" />

                <ItemsControl ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickActionEditorViewModel}">
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>

                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Header, Converter={StaticResource LocalizeKey}}" />

                                    <!--
                                        Típus. A GroupName a szerkesztő fejlécéből jön, hogy a két
                                        gyorsgomb rádiói biztosan külön csoportba essenek — enélkül
                                        a második szerkesztő választása kikapcsolná az elsőét.
                                    -->
                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <RadioButton
                                            Margin="0,0,18,0"
                                            Content="{loc:Loc Type_Folder}"
                                            GroupName="{Binding Header}"
                                            IsChecked="{Binding Kind, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Folder}" />
                                        <RadioButton
                                            Content="{loc:Loc Type_File}"
                                            GroupName="{Binding Header}"
                                            IsChecked="{Binding Kind, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=File}" />
                                    </StackPanel>

                                    <!--  Kiterjesztés — csak fájlnál  -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc Settings_Extension}" />
                                        <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Extension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  Névsablon + élő előnézet  -->
                                    <TextBlock Margin="0,0,0,4" Text="{loc:Loc Settings_NameTemplate}" />
                                    <ui:TextBox Text="{Binding NameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_TemplateHint}" />

                                    <Border
                                        Margin="0,8,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc Settings_Preview}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Preview}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Cél  -->
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="{loc:Loc Settings_UseFixedPath}"
                                        IsChecked="{Binding UseFixedPath, Mode=TwoWay}" />

                                    <Grid Visibility="{Binding UseFixedPath, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Text="{Binding FixedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Command="{Binding BrowseFolderCommand}"
                                            Content="{loc:Loc Settings_Browse}" />
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="2,10,0,0"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_AutoSaved}" />

                <!--  ===== Címkék =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Nav_Tags}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_TagsHint}" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Színminta ÉS színválasztó gomb egyben — lásd
                                            Controls/TagSwatch.cs. A minta a címke saját
                                            színével van kitöltve (egyedi hexszel is), és
                                            mindig kap szegélyt, hogy világos témában egy
                                            fehér címke se olvadjon bele a háttérbe.
                                        -->
                                        <ui:Button
                                            x:Name="ColorButton"
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            Appearance="Transparent"
                                            Command="{Binding TogglePickerCommand}"
                                            ToolTip="{loc:Loc Tags_PickColor}">
                                            <controls:TagSwatch ColorHex="{Binding ColorHex}" TagColor="{Binding Color}" />
                                        </ui:Button>

                                        <Popup
                                            Grid.Column="0"
                                            AllowsTransparency="True"
                                            IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                                            Placement="Bottom"
                                            PlacementTarget="{Binding ElementName=ColorButton}"
                                            StaysOpen="False">
                                            <Border
                                                Padding="12"
                                                Background="{DynamicResource TokenBgElevated}"
                                                BorderBrush="{DynamicResource TokenBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Width="216">
                                                    <ItemsControl ItemsSource="{Binding Presets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type metadata:TagColor}">
                                                                <ui:Button
                                                                    Margin="2"
                                                                    Padding="4"
                                                                    Appearance="Transparent"
                                                                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                    <controls:TagSwatch
                                                                        Width="20"
                                                                        Height="20"
                                                                        TagColor="{Binding}" />
                                                                </ui:Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock
                                                        Margin="2,10,0,4"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TokenTextSecondary}"
                                                        Text="{loc:Loc Tags_CustomColor}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  Élő előnézet: a beírt hex azonnal látszik, még alkalmazás előtt.  -->
                                                        <controls:TagSwatch
                                                            Grid.Column="0"
                                                            Width="24"
                                                            Height="24"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            ColorHex="{Binding CustomHexInput}"
                                                            TagColor="{Binding Color}" />
                                                        <ui:TextBox
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            PlaceholderText="#RRGGBB"
                                                            Text="{Binding CustomHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:Button
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding ApplyCustomHexCommand}"
                                                            Content="{loc:Loc Cmd_Apply}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <ui:TextBox
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <ui:Button
                                            Grid.Column="2"
                                            Padding="6"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc Cmd_Delete}">
                                            <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Új címke: szín + név + hozzáadás  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                Width="62"
                                Margin="0,0,8,0"
                                ItemsSource="{Binding TagColors}"
                                SelectedItem="{Binding NewTagColor, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type metadata:TagColor}">
                                        <controls:TagSwatch TagColor="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:TextBox
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                PlaceholderText="{loc:Loc Settings_NewTagPlaceholder}"
                                Text="{Binding NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding AddTagCommand}"
                                Content="{loc:Loc Cmd_Add}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ===== Frissítések =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Updates}" />

                <Border Style="{StaticResource CardStyle}" DataContext="{Binding Updates}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Settings_CurrentVersion}" />
                                    <!--
                                        Nincs szándékos vizuális jelzés (kurzor,
                                        aláhúzás) — lásd a Hibabejelentés fejlécének
                                        10-kattintásos gesztusát fentebb, ugyanaz a
                                        minta: SettingsViewModel.RegisterVersionClick,
                                        7 kattintásra rejtett üzenet bukkan fel.
                                    -->
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontWeight="SemiBold"
                                        MouseLeftButtonDown="OnVersionClick"
                                        Text="{Binding CurrentVersion, StringFormat=v{0}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_UpdatesHint}" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <ui:ProgressRing
                                    Width="18"
                                    Height="18"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Command="{Binding CheckNowCommand}"
                                    Content="{loc:Loc Update_CheckNow}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Grid>
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource CaptionStyle}"
                            Text="{Binding StatusMessage}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!--  ===== Hibabejelentés =====  -->
                <!--
                    A fejlécre kattintás nem véletlen: 10 kattintásra nyílik
                    fel a lenti fejlesztői (Discord-integrációs) panel — lásd
                    OnBugReportHeaderClick és BugReportViewModel.RegisterSecretClick.
                    Szándékosan nincs vizuális jelzés (kurzor, aláhúzás), hogy a
                    hétköznapi felhasználó ne is sejtse.
                -->
                <TextBlock
                    MouseLeftButtonDown="OnBugReportHeaderClick"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{loc:Loc Settings_BugReport}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_BugReportHint}" />

                <!--
                    Alapállapot: csak egy egyszerű, publikus e-mail-cím — a
                    végfelhasználót nem kell terhelni a Discord-integráció
                    részleteivel (webhook/bot-állapot, csatolások stb.).
                -->
                <Border
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    DataContext="{Binding BugReport}"
                    Visibility="{Binding IsAdminPanelUnlocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc Settings_BugReportSimpleMessage}" />
                        <LineBreak />
                        <Hyperlink NavigateUri="mailto:pilaster-explorer@proton.me" RequestNavigate="OnSupportEmailNavigate">
                            <Run Text="pilaster-explorer@proton.me" />
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <!--
                    A teljes fejlesztői panel — csak feloldás után látszik,
                    lásd fent.
                -->
                <Border
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    DataContext="{Binding BugReport}"
                    Visibility="{Binding IsAdminPanelUnlocked, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>

                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc BugReport_DescriptionLabel}" />
                        <ui:TextBox
                            MinHeight="90"
                            MaxHeight="160"
                            AcceptsReturn="True"
                            IsEnabled="{Binding IsConfigured}"
                            PlaceholderText="{loc:Loc BugReport_DescriptionPlaceholder}"
                            Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <CheckBox
                                Margin="0,0,20,0"
                                Content="{loc:Loc BugReport_AttachScreenshot}"
                                IsChecked="{Binding AttachScreenshot, Mode=TwoWay}"
                                IsEnabled="{Binding IsConfigured}" />
                            <CheckBox
                                Content="{loc:Loc BugReport_AttachLog}"
                                IsChecked="{Binding AttachLog, Mode=TwoWay}"
                                IsEnabled="{Binding IsConfigured}" />
                        </StackPanel>

                        <!--
                            Ötlet vs. hiba. A Discord üzenet ez alapján kap
                            [BUG]/[ÖTLET] címkét és eltérő színt — lásd
                            DiscordPayloadBuilder.
                        -->
                        <CheckBox
                            Margin="0,10,0,0"
                            Content="{loc:Loc BugReport_IsFeatureIdea}"
                            IsChecked="{Binding IsFeatureIdea, Mode=TwoWay}"
                            IsEnabled="{Binding IsConfigured}" />

                        <!--  Visszajelzés-sáv: siker zöld pipával, hiba piros felkiáltójellel  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="10,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource TokenSuccess}"
                                    Symbol="CheckmarkCircle24"
                                    Visibility="{Binding StatusIsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource TokenDanger}"
                                    Symbol="ErrorCircle24"
                                    Visibility="{Binding StatusIsError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <ui:ProgressRing
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                IsIndeterminate="True"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button
                                HorizontalAlignment="Right"
                                Appearance="Primary"
                                Command="{Binding SendCommand}"
                                Content="{loc:Loc BugReport_Send}"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Send24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Border>

        <!--
            Rejtett üzenet-toast: a verziószámra 7-szer kattintva (lásd
            OnVersionClick / SettingsViewModel.RegisterVersionClick) bukkan
            fel, magától eltűnik — semmilyen tartós állapotot nem módosít.
        -->
        <Border
            Margin="0,0,0,24"
            Padding="16,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="10"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.35" ShadowDepth="0" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEasterEgg}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{DynamicResource SystemAccentBrush}"
                    Symbol="Sparkle24" />
                <TextBlock
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    Text="{Binding EasterEggMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
