<ui:FluentWindow
    x:Class="Pilaster.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pilaster.App.Controls"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    xmlns:metadata="clr-namespace:Pilaster.Core.Metadata;assembly=Pilaster.Core"
    xmlns:settings="clr-namespace:Pilaster.Core.Settings;assembly=Pilaster.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="{loc:Loc Cmd_Settings}"
    Width="900"
    Height="780"
    MinWidth="760"
    MinHeight="520"
    Icon="pack://application:,,,/Pilaster;component/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="{DynamicResource PilasterWindowBackdrop}"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>

        <!--  Egy beállítás-kártya: cím, leírás, jobb oldalt a vezérlő  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--
            Egyetlen görgethető oldal: minden kategória egymás alatt, saját
            nagy címmel (CategoryHeaderStyle) — a kategórián belüli
            alcsoportok (SectionHeaderStyle) ennél kisebbek és halványabbak,
            hogy a tagolás első ránézésre olvasható legyen.
        -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>

        <!--
            A bal oldali kategórialista sora — lekerekített rámutatás-kiemelés.
            A kijelölést a lista alatti, csúszó SelectionIndicator rajzolja
            (lásd a ListBox előtt). Korábban a WPF alap ListBoxItem szögletes,
            szél-szélig érő kiemelése látszott.
        -->
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedRowFocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="Highlight"
                                Background="Transparent"
                                CornerRadius="6" />
                            <Border Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <!--
                                A KIJELÖLT sor saját kiemelése szándékosan nincs itt:
                                azt a lista alatti, csúszó SelectionIndicator rajzolja.
                                Rámutatáskor a kijelölt sor ne kapjon dupla hátteret.
                            -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{loc:Loc Cmd_Settings}"
            ShowMaximize="False" />

        <Grid Grid.Row="1">
        <Border Background="{DynamicResource GlassPanelBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Keresőmező: névre, leírásra és rejtett kulcsszavakra egyaránt keres (spec F6)  -->
            <ui:TextBox
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="18,4,18,10"
                PlaceholderText="{loc:Loc Settings_SearchPlaceholder}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!--  Bal oldali kategórialista  -->
            <!--
                Tartalomjegyzék: kattintásra az adott kategóriához görget
                (OnCategorySelectionChanged), görgetéskor pedig követi, melyik
                kategóriánál jár a felhasználó (OnContentScrollChanged).
            -->
            <!--
                Csúszó kijelölés: EGYETLEN kiemelés (lekerekített háttér +
                akcentus-sáv) ül a lista ALATT, és a kijelölt sorhoz CSÚSZIK
                (lásd MoveSelectionIndicator) — nem soronként villan fel/el.
                A Windows 11 Gépházának navigációs mintája.
            -->
            <Canvas
                x:Name="IndicatorLayer"
                Grid.Row="1"
                Grid.Column="0"
                Margin="10,0,6,0"
                ClipToBounds="True"
                IsHitTestVisible="False">
                <Grid x:Name="SelectionIndicator" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SelectionIndicatorOffset" />
                    </Grid.RenderTransform>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" />
                    <Border
                        Width="3"
                        Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemAccentBrush}"
                        CornerRadius="1.5" />
                </Grid>
            </Canvas>

            <ListBox
                x:Name="CategoryList"
                Grid.Row="1"
                Grid.Column="0"
                Margin="10,0,6,0"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource CategoryItemStyle}"
                ItemsSource="{Binding Categories}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                SelectionChanged="OnCategorySelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsCategoryViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="{Binding Icon}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Keresési találatok — a kategória tartalma helyett  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="10,0,18,0"
                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsDescriptor}">
                                <ui:Button
                                    Margin="0,0,0,6"
                                    Padding="14,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Secondary"
                                    Command="{Binding DataContext.GoToSettingCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding TitleKey, Converter={StaticResource LocalizeKey}}" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TokenTextSecondary}"
                                            Text="{Binding DescriptionKey, Converter={StaticResource LocalizeKey}}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ScrollViewer
                x:Name="ContentScroll"
                Grid.Row="1"
                Grid.Column="1"
                Padding="14,0,18,4"
                ScrollChanged="OnContentScrollChanged"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel>

                <!--  ===== general =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:general">
                    <Grid Margin="2,4,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_General}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="general"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>


                    <Border Style="{StaticResource CardStyle}" Tag="general.restoreSession">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_RestoreSession}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_RestoreSessionHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding RestoreSession, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="general.startupFolder" IsEnabled="{Binding RestoreSession, Converter={StaticResource InvertBool}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_StartupFolder}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_StartupFolderHint}" />
                            <ui:TextBox Margin="0,10,0,0" Text="{Binding StartupFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="general.singleInstance">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_SingleInstance}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_SingleInstanceHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding SingleInstance, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Language}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_LanguageHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </Border>
                </StackPanel>

                <!--  ===== appearance =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:appearance">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_Appearance}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="appearance"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>


                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Theme}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ThemeHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:ThemeMode}">
                                    <TextBlock Text="{Binding Converter={StaticResource ThemeMode}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Accent}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_AccentHint}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc Settings_AccentUseSystem}" />
                                <ui:ToggleSwitch IsChecked="{Binding UseSystemAccent, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!--
                            A paletta és a hex mező letiltva, amíg a rendszerszínt
                            követjük — enélkül úgy tűnne, mintha egyedi szín is
                            hatna, holott a kapcsoló felülírná a következő
                            rendszertéma-váltáskor.
                        -->
                        <ItemsControl
                            Margin="0,14,0,0"
                            IsEnabled="{Binding UseSystemAccent, Converter={StaticResource InvertBool}}"
                            ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type media:Color}">
                                    <ui:Button
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,8,8"
                                        Padding="0"
                                        Appearance="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SelectAccentPresetCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="16">
                                        <Ellipse
                                            Width="24"
                                            Height="24"
                                            Fill="{Binding Converter={StaticResource ColorToBrush}}" />
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0" IsEnabled="{Binding UseSystemAccent, Converter={StaticResource InvertBool}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                Margin="0,0,10,0"
                                Fill="{Binding CurrentAccentColor, Converter={StaticResource ColorToBrush}}" />
                            <ui:TextBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{Binding AccentHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding ApplyAccentHexCommand}"
                                Content="{loc:Loc Cmd_Apply}" />
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource TokenDanger}"
                            Text="{Binding AccentHexError}"
                            Visibility="{Binding AccentHexError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Animations}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_AnimationsHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding AnimationLevels}"
                            SelectedItem="{Binding SelectedAnimationLevel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:AnimationLevel}">
                                    <TextBlock Text="{Binding Converter={StaticResource AnimationLevel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Tag="appearance.performance">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_PerformanceMode}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_PerformanceModeHint}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding EnablePerformanceModeCommand}"
                            Content="{loc:Loc Settings_PerformanceModeApply}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Tag="appearance.glass">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_LiquidGlass}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_LiquidGlassHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding LiquidGlassEnabled, Mode=TwoWay}" />

                        <!--  Erősség — csak bekapcsolt üveghatásnál van értelme, ezért kikapcsolva letiltott.  -->
                        <Grid
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            IsEnabled="{Binding LiquidGlassEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Text="{loc:Loc Settings_GlassIntensity}" />
                            <Slider
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="5"
                                Value="{Binding GlassIntensity, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding GlassIntensity, StringFormat={}{0}%}" />
                        </Grid>
                    </Grid>
                </Border>
                </StackPanel>

                <!--  ===== panes =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:panes">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_Panes}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="panes"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>


                    <Border Style="{StaticResource CardStyle}" Tag="panes.vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_DualPaneVertical}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_DualPaneVerticalHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding DualPaneVertical, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="panes.splitRatio">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_SplitRatio}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_SplitRatioHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="panes.rowStriping">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_RowStriping}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_RowStripingHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding DualPaneRowStriping, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="panes.columnWidths">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_ColumnWidths}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ColumnWidthsHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ===== filelist =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:filelist">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_FileList}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="filelist"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>


                    <Border Style="{StaticResource CardStyle}" Tag="filelist.system">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_ShowSystem}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShowSystemHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowSystemItems, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="filelist.extensions">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_ShowExtensions}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShowExtensionsHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowExtensions, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="filelist.foldersFirst">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_FoldersFirst}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_FoldersFirstHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding FoldersFirst, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="filelist.columns">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_ExtraColumns}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ExtraColumnsHint}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{loc:Loc Col_Created}" />
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowCreatedColumn, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{loc:Loc Col_Accessed}" />
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowAccessedColumn, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="filelist.sizeUnits">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_BinarySizeUnits}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_BinarySizeUnitsHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding BinarySizeUnits, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ===== keyboard =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:keyboard">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_Keyboard}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="keyboard"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>

                <!--  ===== Billentyűkiosztás =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Keymap}" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Keymap}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_KeymapHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                Width="240"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Keymaps}"
                                SelectedItem="{Binding SelectedKeymap, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource KeymapName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <ui:Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleKeymapTableCommand}"
                            Content="{loc:Loc Keymap_ViewTable}" />

                        <!--  A preset teljes billentyűlistája (spec F1)  -->
                        <Border
                            Margin="0,12,0,0"
                            Background="{DynamicResource TokenBgApp}"
                            BorderBrush="{DynamicResource TokenBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsKeymapTableVisible, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding KeymapRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Action}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="Consolas"
                                                    Foreground="{DynamicResource TokenAccent}"
                                                    Text="{Binding Gesture}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{DynamicResource TokenTextSecondary}"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_ExternalEditor}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ExternalEditorHint}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding ExternalEditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseExternalEditorCommand}"
                                Content="{loc:Loc Cmd_Browse}" />
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!--  ===== contextmenu =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:contextmenu">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_ContextMenu}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="contextmenu"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>


                    <!--  Megjelenítési mód (spec v1.0.3) — a legfontosabb kapcsoló, ezért legfelül.  -->
                    <Border Style="{StaticResource CardStyle}" Tag="contextmenu.mode">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" Text="{loc:Loc Settings_ContextMenuMode}" />

                            <RadioButton
                                Margin="0,0,0,10"
                                GroupName="ContextMenuMode"
                                IsChecked="{Binding ContextMenuMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Windows}">
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{loc:Loc Settings_ContextMenuMode_Windows}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ContextMenuMode_WindowsHint}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                GroupName="ContextMenuMode"
                                IsChecked="{Binding ContextMenuMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Pilaster}">
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{loc:Loc Settings_ContextMenuMode_Pilaster}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ContextMenuMode_PilasterHint}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="contextmenu.shell">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_ShellExtensions}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShellExtensionsHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShellExtensionsEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="contextmenu.timeout" IsEnabled="{Binding ShellExtensionsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_ShellTimeout}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShellTimeoutHint}" />
                            </StackPanel>
                            <ui:NumberBox
                                ClearButtonEnabled="False"
                                Grid.Column="1"
                                Width="150"
                                VerticalAlignment="Center"
                                Maximum="5000"
                                Minimum="50"
                                Value="{Binding ShellMenuTimeoutMs, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="contextmenu.section" IsEnabled="{Binding ShellExtensionsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_ShellOwnSection}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShellOwnSectionHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShellItemsInOwnSection, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!--  Előretöltés kijelöléskor (spec A2, v1.0.2)  -->
                    <Border Style="{StaticResource CardStyle}" Tag="contextmenu.preload" IsEnabled="{Binding ShellExtensionsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_ContextMenuPreload}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ContextMenuPreloadHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ContextMenuPreloadEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!--  Összeomlás utáni visszakapcsolás (spec P3)  -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{Binding ShellDisabledAfterCrash, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_ShellReenable}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShellReenableHint}" />
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding ShellCrashPath, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TokenTextMuted}"
                                    Text="{loc:Loc Settings_ShellCrashPath}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TokenWarning}"
                                    Text="{Binding ShellCrashPath}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ReenableShellExtensionsCommand}"
                                Content="{loc:Loc Settings_ShellReenable}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Tag="contextmenu.blacklist" IsEnabled="{Binding ShellExtensionsEnabled}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_ShellBlacklist}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ShellBlacklistHint}" />
                            <ui:TextBox
                                MinHeight="80"
                                Margin="0,10,0,0"
                                AcceptsReturn="True"
                                Text="{Binding ShellBlacklistText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ===== editor =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:editor">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_Editor}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="editor"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>


                    <Border Style="{StaticResource CardStyle}" Tag="editor.font">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_EditorFont}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_EditorFontHint}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding EditorFontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <ui:NumberBox
                                    ClearButtonEnabled="False"
                                    Grid.Column="1"
                                    Width="150"
                                    Maximum="48"
                                    Minimum="6"
                                    Value="{Binding EditorFontSize, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="editor.tabWidth">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_EditorTabWidth}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_EditorTabWidthHint}" />
                                </StackPanel>
                                <ui:NumberBox
                                    ClearButtonEnabled="False"
                                    Grid.Column="1"
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Maximum="16"
                                    Minimum="1"
                                    Value="{Binding EditorTabWidth, Mode=TwoWay}" />
                            </Grid>
                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{loc:Loc Settings_EditorInsertSpaces}"
                                IsChecked="{Binding EditorInsertSpaces, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="editor.wordWrap">
                        <StackPanel>
                            <CheckBox Content="{loc:Loc Settings_EditorWordWrap}" IsChecked="{Binding EditorWordWrap, Mode=TwoWay}" />
                            <CheckBox Margin="0,8,0,0" Content="{loc:Loc Settings_EditorLineNumbers}" IsChecked="{Binding EditorShowLineNumbers, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_EditorWordWrapHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="editor.encoding">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_EditorEncoding}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_EditorEncodingHint}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                Width="160"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Encodings}"
                                SelectedItem="{Binding EditorDefaultEncoding, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="editor.lineEnding">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_EditorLineEnding}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_EditorLineEndingHint}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                Width="160"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding LineEndings}"
                                SelectedItem="{Binding EditorDefaultLineEnding, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Tag="editor.window">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_EditorWindow}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_EditorWindowHint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding EditorInSeparateWindow, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ===== tags =====  -->
                <StackPanel Margin="0,0,0,12" Tag="category:tags">
                    <Grid Margin="2,22,0,6">
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_Tags}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="tags"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>

                <!--  ===== Címkék =====  -->
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_TagsHint}" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Színminta ÉS színválasztó gomb egyben — lásd
                                            Controls/TagSwatch.cs. A minta a címke saját
                                            színével van kitöltve (egyedi hexszel is), és
                                            mindig kap szegélyt, hogy világos témában egy
                                            fehér címke se olvadjon bele a háttérbe.
                                        -->
                                        <ui:Button
                                            x:Name="ColorButton"
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            Appearance="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding TogglePickerCommand}"
                                            ToolTip="{loc:Loc Tags_PickColor}">
                                            <controls:TagSwatch ColorHex="{Binding ColorHex}" TagColor="{Binding Color}" />
                                        </ui:Button>

                                        <Popup
                                            Grid.Column="0"
                                            AllowsTransparency="True"
                                            IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                                            Placement="Bottom"
                                            PlacementTarget="{Binding ElementName=ColorButton}"
                                            StaysOpen="False">
                                            <Border
                                                Margin="0,4,8,8"
                                                Padding="10"
                                                Background="{DynamicResource TokenBgElevated}"
                                                BorderBrush="{DynamicResource TokenBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" Opacity="0.25" ShadowDepth="2" />
                                                </Border.Effect>
                                                <StackPanel Width="216">
                                                    <ItemsControl ItemsSource="{Binding Presets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type metadata:TagColor}">
                                                                <ui:Button
                                                                    Width="34"
                                                                    Height="34"
                                                                    Margin="1"
                                                                    Padding="0"
                                                                    Appearance="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="0"
                                                                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    CornerRadius="17">
                                                                    <!--  A kiválasztott szín körül accent gyűrű.  -->
                                                                    <Border
                                                                        Width="28"
                                                                        Height="28"
                                                                        BorderThickness="2"
                                                                        CornerRadius="14">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True">
                                                                                        <DataTrigger.Binding>
                                                                                            <MultiBinding Converter="{StaticResource AllEqual}">
                                                                                                <Binding />
                                                                                                <Binding Path="DataContext.Color" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                            </MultiBinding>
                                                                                        </DataTrigger.Binding>
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <controls:TagSwatch
                                                                            Width="20"
                                                                            Height="20"
                                                                            TagColor="{Binding}" />
                                                                    </Border>
                                                                </ui:Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock
                                                        Margin="2,10,0,4"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TokenTextSecondary}"
                                                        Text="{loc:Loc Tags_CustomColor}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  Élő előnézet: a beírt hex azonnal látszik, még alkalmazás előtt.  -->
                                                        <controls:TagSwatch
                                                            Grid.Column="0"
                                                            Width="24"
                                                            Height="24"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            ColorHex="{Binding CustomHexInput}"
                                                            TagColor="{Binding Color}" />
                                                        <ui:TextBox
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            PlaceholderText="#RRGGBB"
                                                            Text="{Binding CustomHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:Button
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding ApplyCustomHexCommand}"
                                                            Content="{loc:Loc Cmd_Apply}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <ui:TextBox
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <ui:Button
                                            Grid.Column="2"
                                            Padding="6"
                                            Appearance="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc Cmd_Delete}">
                                            <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Új címke: szín + név + hozzáadás  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                                Színválasztó gomb + felugró paletta — ugyanaz, mint a
                                meglévő címkéknél. Korábban egy 62 DIP széles legördülő
                                volt, amiben a kiválasztott színminta félig levágódott.
                            -->
                            <ui:Button
                                x:Name="NewTagColorButton"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Padding="8"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleNewTagPickerCommand}"
                                ToolTip="{loc:Loc Tags_PickColor}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:TagSwatch
                                        Width="16"
                                        Height="16"
                                        TagColor="{Binding NewTagColor}" />
                                    <ui:SymbolIcon
                                        Margin="6,0,0,0"
                                        FontSize="10"
                                        Symbol="ChevronDown24" />
                                </StackPanel>
                            </ui:Button>
                            <Popup
                                Grid.Column="0"
                                AllowsTransparency="True"
                                IsOpen="{Binding IsNewTagPickerOpen, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=NewTagColorButton}"
                                StaysOpen="False">
                                <Border
                                    Margin="0,4,8,8"
                                    Padding="10"
                                    Background="{DynamicResource TokenBgElevated}"
                                    BorderBrush="{DynamicResource TokenBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.25" ShadowDepth="2" />
                                    </Border.Effect>
                                    <ItemsControl ItemsSource="{Binding TagColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type metadata:TagColor}">
                                                <ui:Button
                                                    Width="34"
                                                    Height="34"
                                                    Margin="1"
                                                    Padding="0"
                                                    Appearance="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectNewTagColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    CornerRadius="17">
                                                    <!--  A kiválasztott szín körül accent gyűrű.  -->
                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        BorderThickness="2"
                                                        CornerRadius="14">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource AllEqual}">
                                                                                <Binding />
                                                                                <Binding Path="DataContext.NewTagColor" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <controls:TagSwatch
                                                            Width="20"
                                                            Height="20"
                                                            TagColor="{Binding}" />
                                                    </Border>
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                            <ui:TextBox
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                PlaceholderText="{loc:Loc Settings_NewTagPlaceholder}"
                                Text="{Binding NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding AddTagCommand}"
                                Content="{loc:Loc Cmd_Add}" />
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

