                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Tag="integrations.filedialog">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_FileDialogCompanion}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_FileDialogCompanionHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding FileDialogCompanionEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc ShellIntegration_ResetAll}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc ShellIntegration_ResetAllHint}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding ResetShellIntegrationCommand}"
