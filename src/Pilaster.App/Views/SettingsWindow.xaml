<ui:FluentWindow
    x:Class="Pilaster.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Pilaster.App.Localization"
    xmlns:metadata="clr-namespace:Pilaster.Core.Metadata;assembly=Pilaster.Core"
    xmlns:settings="clr-namespace:Pilaster.Core.Settings;assembly=Pilaster.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pilaster.App.ViewModels"
    Title="{loc:Loc Cmd_Settings}"
    Width="640"
    Height="760"
    MinWidth="520"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>

        <!--  Egy beállítás-kártya: cím, leírás, jobb oldalt a vezérlő  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{loc:Loc Cmd_Settings}"
            ShowMaximize="False" />

        <Border Grid.Row="1" Background="{DynamicResource GlassPanelBrush}">
        <ScrollViewer
            x:Name="ContentScroll"
            Padding="22,4,22,22"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ===== Megjelenés =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Appearance}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Theme}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_ThemeHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:ThemeMode}">
                                    <TextBlock Text="{Binding Converter={StaticResource ThemeMode}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Animations}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_AnimationsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_LiquidGlass}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_LiquidGlassHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding LiquidGlassEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  ===== Nyelv =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Language}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Language}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_LanguageHint}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  ===== Gyorsgombok =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_QuickActions}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_QuickActionsHint}" />

                <ItemsControl ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickActionEditorViewModel}">
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>

                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Header, Converter={StaticResource LocalizeKey}}" />

                                    <!--
                                        Típus. A GroupName a szerkesztő fejlécéből jön, hogy a két
                                        gyorsgomb rádiói biztosan külön csoportba essenek — enélkül
                                        a második szerkesztő választása kikapcsolná az elsőét.
                                    -->
                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <RadioButton
                                            Margin="0,0,18,0"
                                            Content="{loc:Loc Type_Folder}"
                                            GroupName="{Binding Header}"
                                            IsChecked="{Binding Kind, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=Folder}" />
                                        <RadioButton
                                            Content="{loc:Loc Type_File}"
                                            GroupName="{Binding Header}"
                                            IsChecked="{Binding Kind, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=File}" />
                                    </StackPanel>

                                    <!--  Kiterjesztés — csak fájlnál  -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc Settings_Extension}" />
                                        <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Extension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  Névsablon + élő előnézet  -->
                                    <TextBlock Margin="0,0,0,4" Text="{loc:Loc Settings_NameTemplate}" />
                                    <ui:TextBox Text="{Binding NameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_TemplateHint}" />

                                    <Border
                                        Margin="0,8,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{loc:Loc Settings_Preview}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Preview}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Cél  -->
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="{loc:Loc Settings_UseFixedPath}"
                                        IsChecked="{Binding UseFixedPath, Mode=TwoWay}" />

                                    <Grid Visibility="{Binding UseFixedPath, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Text="{Binding FixedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Command="{Binding BrowseFolderCommand}"
                                            Content="{loc:Loc Settings_Browse}" />
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="2,10,0,0"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_AutoSaved}" />

                <!--  ===== Címkék =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Nav_Tags}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_TagsHint}" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            Grid.Column="0"
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Color, Converter={StaticResource TagColorBrush}}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <ui:Button
                                            Grid.Column="2"
                                            Padding="6"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc Cmd_Delete}">
                                            <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Új címke: szín + név + hozzáadás  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                Width="52"
                                Margin="0,0,8,0"
                                ItemsSource="{Binding TagColors}"
                                SelectedItem="{Binding NewTagColor, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type metadata:TagColor}">
                                        <Ellipse
                                            Width="14"
                                            Height="14"
                                            Fill="{Binding Converter={StaticResource TagColorBrush}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:TextBox
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                PlaceholderText="{loc:Loc Settings_NewTagPlaceholder}"
                                Text="{Binding NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding AddTagCommand}"
                                Content="{loc:Loc Cmd_Add}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ===== Frissítések =====  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Updates}" />

                <Border Style="{StaticResource CardStyle}" DataContext="{Binding Updates}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Settings_CurrentVersion}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontWeight="SemiBold"
                                        Text="{Binding CurrentVersion, StringFormat=v{0}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc Settings_UpdatesHint}" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <ui:ProgressRing
                                    Width="18"
                                    Height="18"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Command="{Binding CheckNowCommand}"
                                    Content="{loc:Loc Update_CheckNow}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Grid>
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource CaptionStyle}"
                            Text="{Binding StatusMessage}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!--  ===== Hibabejelentés =====  -->
                <!--
                    A fejlécre kattintás nem véletlen: 10 kattintásra nyílik
                    fel a lenti fejlesztői (Discord-integrációs) panel — lásd
                    OnBugReportHeaderClick és BugReportViewModel.RegisterSecretClick.
                    Szándékosan nincs vizuális jelzés (kurzor, aláhúzás), hogy a
                    hétköznapi felhasználó ne is sejtse.
                -->
                <TextBlock
                    MouseLeftButtonDown="OnBugReportHeaderClick"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{loc:Loc Settings_BugReport}" />
                <TextBlock
                    Margin="2,0,0,10"
                    Style="{StaticResource CaptionStyle}"
                    Text="{loc:Loc Settings_BugReportHint}" />

                <!--
                    Alapállapot: csak egy egyszerű, publikus e-mail-cím — a
                    végfelhasználót nem kell terhelni a Discord-integráció
                    részleteivel (webhook/bot-állapot, csatolások stb.).
                -->
                <Border
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    DataContext="{Binding BugReport}"
                    Visibility="{Binding IsAdminPanelUnlocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc Settings_BugReportSimpleMessage}" />
                        <LineBreak />
                        <Hyperlink NavigateUri="mailto:pilaster-explorer@proton.me" RequestNavigate="OnSupportEmailNavigate">
                            <Run Text="pilaster-explorer@proton.me" />
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <!--
                    A teljes fejlesztői panel — csak feloldás után látszik,
                    lásd fent.
                -->
                <Border
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    DataContext="{Binding BugReport}"
                    Visibility="{Binding IsAdminPanelUnlocked, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>

                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc BugReport_DescriptionLabel}" />
                        <ui:TextBox
                            MinHeight="90"
                            MaxHeight="160"
                            AcceptsReturn="True"
                            IsEnabled="{Binding IsConfigured}"
                            PlaceholderText="{loc:Loc BugReport_DescriptionPlaceholder}"
                            Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <CheckBox
                                Margin="0,0,20,0"
                                Content="{loc:Loc BugReport_AttachScreenshot}"
                                IsChecked="{Binding AttachScreenshot, Mode=TwoWay}"
                                IsEnabled="{Binding IsConfigured}" />
                            <CheckBox
                                Content="{loc:Loc BugReport_AttachLog}"
                                IsChecked="{Binding AttachLog, Mode=TwoWay}"
                                IsEnabled="{Binding IsConfigured}" />
                        </StackPanel>

                        <!--
                            Ötlet vs. hiba. A Discord üzenet ez alapján kap
                            [BUG]/[ÖTLET] címkét és eltérő színt — lásd
                            DiscordPayloadBuilder.
                        -->
                        <CheckBox
                            Margin="0,10,0,0"
                            Content="{loc:Loc BugReport_IsFeatureIdea}"
                            IsChecked="{Binding IsFeatureIdea, Mode=TwoWay}"
                            IsEnabled="{Binding IsConfigured}" />

                        <!--  Visszajelzés-sáv: siker zöld pipával, hiba piros felkiáltójellel  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="10,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="#22C55E"
                                    Symbol="CheckmarkCircle24"
                                    Visibility="{Binding StatusIsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="#EF4444"
                                    Symbol="ErrorCircle24"
                                    Visibility="{Binding StatusIsError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <ui:ProgressRing
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                IsIndeterminate="True"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button
                                HorizontalAlignment="Right"
                                Appearance="Primary"
                                Command="{Binding SendCommand}"
                                Content="{loc:Loc BugReport_Send}"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Send24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
