                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc ShellIntegration_ContextMenu}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{loc:Loc ShellIntegration_ContextMenuHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch
