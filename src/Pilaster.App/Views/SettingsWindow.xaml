                        <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="{loc:Loc SettingsCat_Integrations}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding ResetCategoryCommand}"
                            CommandParameter="integrations"
                            Content="{loc:Loc Settings_ResetCategory}"
                            FontSize="12" />
                    </Grid>

                <!--  ===== Panelek =====  -->
                

                <!--  ===== Fájllista =====  -->
                

                <!--  ===== Jobbklikk menü =====  -->
                

                <!--  ===== Szerkesztő =====  -->
                

                <!--  ===== Speciális: naplózás és mappák =====  -->
                

                <!--  ===== Általános: indulás és munkamenet =====  -->
                

