<UserControl
    x:Class="Pilaster.Setup.Views.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="680"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush Opacity="0.16" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorPrimary}" />
                <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image
                x:Name="LockupImage"
                Width="360"
                Margin="0,0,0,28"
                RenderTransformOrigin="0.5,0.5"
                Source="pack://application:,,,/Pilaster.Setup;component/Assets/lockup-512.png">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LockupScale" ScaleX="0.92" ScaleY="0.92" />
                </Image.RenderTransform>
            </Image>

            <TextBlock
                x:Name="TaglineText"
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                RenderTransformOrigin="0.5,0.5"
                Text="Üdvözlünk a Pilaster telepítőjében">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TaglineOffset" Y="16" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
