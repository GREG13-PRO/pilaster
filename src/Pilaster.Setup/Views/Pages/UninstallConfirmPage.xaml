<UserControl
    x:Class="Pilaster.Setup.Views.Pages.UninstallConfirmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="680"
    mc:Ignorable="d">

    <StackPanel
        MaxWidth="440"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Image
            Width="72"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            Source="pack://application:,,,/Pilaster.Setup;component/Assets/app.ico" />

        <TextBlock
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Pilaster eltávolítása erről a gépről?" />

        <TextBlock
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Text="A program fájljai, a parancsikonok és a rendszerintegráció eltávolításra kerülnek." />

        <CheckBox
            x:Name="DeleteSettingsCheckBox"
            HorizontalAlignment="Center"
            Content="A beállításaimat és a címkéimet is töröld" />
    </StackPanel>
</UserControl>
