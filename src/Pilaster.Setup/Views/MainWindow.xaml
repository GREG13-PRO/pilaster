<ui:FluentWindow
    x:Class="Pilaster.Setup.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Pilaster Setup"
    Width="680"
    Height="520"
    MinWidth="680"
    MinHeight="520"
    ResizeMode="CanMinimize"
    Icon="pack://application:,,,/Pilaster.Setup;component/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBarHost"
            Grid.Row="0"
            ShowMaximize="False"
            Title="Pilaster Setup" />

        <Grid Grid.Row="1" ClipToBounds="True">
            <ContentControl x:Name="PageHost" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageTransform" X="0" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="24,16"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <ui:Button
                    x:Name="BackButton"
                    DockPanel.Dock="Left"
                    Click="OnBackClick"
                    Content="Vissza" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="CancelButton"
                        Margin="0,0,8,0"
                        Click="OnCancelClick"
                        Content="Mégse" />
                    <ui:Button
                        x:Name="NextButton"
                        Appearance="Primary"
                        Click="OnNextClick"
                        Content="Tovább" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
