<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pilaster.Shell</RootNamespace>
    <AssemblyName>Pilaster.Shell</AssemblyName>

    <!--
      A shell ikon- és bélyegkép-kinyerés közvetlenül WPF ImageSource-t ad
      vissza, ezért ez az assembly WPF-típusokra hivatkozik. Nem tartalmaz
      XAML-t és nem hoz be UI-t — csak a PresentationCore képtípusait.
    -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pilaster.Core\Pilaster.Core.csproj" />
  </ItemGroup>

  <!--
    A meghajtó-kiadás (DeviceIoControl-alapú kötetzárolás/leválasztás) és a
    lemezikon-kinyerés (autorun.inf ICON=) kézzel írt P/Invoke-kal rendkívül
    hibalehetőség-érzékeny volna — ezért itt, a projekt eredeti tervében is
    szereplő Vanara csomagokra támaszkodunk, amik ezt már helyesen
    csomagolják (biztonságos handle-ök, helyesen marshalt struktúrák).
  -->
  <ItemGroup>
    <PackageReference Include="Vanara.PInvoke.Kernel32" Version="$(VanaraVersion)" />
    <PackageReference Include="Vanara.PInvoke.Shell32" Version="$(VanaraVersion)" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="$(VanaraVersion)" />

    <!--
    HELYESBÍTÉS (v1.0.3): az alábbi megjegyzés korábban azt állította, hogy a
    Vanara.Windows.Shell.ShellContextMenu (PIDL-kezelés, TrackPopupMenuEx,
    üzenet-továbbítás) "tesztelt, biztonságos" — ez ELAVULT és TÉVES. A
    ShellContextMenu.CreateFromItems a dokumentált, öt körös 0xC0000374
    heap-korrupció bizonyított okozója volt (lásd docs/CONTEXT-MENU.md,
    "Miért NYERS a fájlmenü beszerzése"), ezért a FÁJL-elemek menüje azóta
    NYERS P/Invoke-kal épül (ShellMenuSession.CreateForItems). A csomag itt
    csak azért marad, mert a MAPPA-HÁTTÉR menüjéhez (IShellFolder.
    CreateViewObject, NEM CreateFromItems) és a lemezikon-kinyeréshez ma is
    kell — ez a hívási minta a bisectben SOHA nem volt vétkes. Ne használd a
    ShellContextMenu.CreateFromItems-t vagy a ShellContextMenu.ShowContextMenu-t
    fájl-elemekre — csak a NYERS utat.
  -->
    <PackageReference Include="Vanara.Windows.Shell.Common" Version="$(VanaraVersion)" />
  </ItemGroup>

</Project>
