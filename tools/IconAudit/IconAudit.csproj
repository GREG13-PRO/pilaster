<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A kiadás előtti tálcaikon-ellenőrzés eszköze (spec A3). A beágyazott .ico
    rétegeit, az exe VersionInfo-ját és egy szintetikus parancsikon
    System.AppUserModel.ID kerekítését vizsgálja — semmi Pilaster-kód, semmi
    Vanara, csak nyers P/Invoke és a WPF képfeldolgozó API-k (multi-frame .ico
    dekódolásához).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>IconAudit</RootNamespace>
    <AssemblyName>IconAudit</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
