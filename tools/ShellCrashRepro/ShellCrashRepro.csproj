<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SZÁNDÉKOSAN MINIMÁLIS. Se Pilaster-kód, se Vanara, se WPF — csak nyers
    P/Invoke. Ez a referencia annak eldöntésére, hogy a shell-bővítmények
    önmagukban rontják-e a hívó folyamat heapjét, vagy a Pilaster
    shell-gazdálkodása a hibás.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>ShellCrashRepro</RootNamespace>
    <AssemblyName>ShellCrashRepro</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    A B2 lépéshez (és CSAK ahhoz): a Pilaster Vanara-rétege. A „vanara"
    parancssori kapcsoló nélkül egyetlen sor sem hívódik meg belőle, tehát az
    alap referencia-mérés továbbra is teljesen külső függőség nélküli.
  -->
  <ItemGroup>
    <PackageReference Include="Vanara.PInvoke.Shell32" Version="5.0.6" />
    <PackageReference Include="Vanara.Windows.Shell.Common" Version="5.0.6" />
  </ItemGroup>

</Project>
