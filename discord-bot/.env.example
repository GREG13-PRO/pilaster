# Másold .env néven, és töltsd ki. A .env SOHA ne kerüljön a repóba
# (a .gitignore már kizárja).

# A Discord Developer Portalon (discord.com/developers/applications)
# létrehozott alkalmazás bot tokenje — Bot szakasz, "Reset Token".
DISCORD_BOT_TOKEN=

# Az a csatorna, ahova a Pilaster a hibajelentéseket/ötleteket küldi.
# Jobbklikk a csatornán Discordban -> "ID másolása" (fejlesztői mód kell hozzá).
REPORT_CHANNEL_ID=

# Az a csatorna, ahova a "Kész" gombra kattintva a lezárt jelentés kerül,
# és ahonnan 30 nap után automatikusan törlődik.
ARCHIVE_CHANNEL_ID=

# Megosztott titok a Pilaster asztali alkalmazás és e bot között — a Pilaster
# ezt küldi az X-Api-Key fejlécben. Bármilyen hosszú, véletlenszerű string jó,
# pl.: openssl rand -hex 32
API_KEY=

# A HTTP szerver portja, amin a /report végpont figyel.
PORT=3000
